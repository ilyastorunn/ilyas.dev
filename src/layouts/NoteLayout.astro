---
import SiteLayout from "./SiteLayout.astro";
interface Props { title: string; description: string; publishedAt: Date; }
const { title, description, publishedAt } = Astro.props;
const date = new Intl.DateTimeFormat("en", { year: "numeric", month: "long", day: "numeric" }).format(publishedAt);
---
<SiteLayout title={`${title} — İlyas Torun`} description={description} current="cave">
  <article class="note content-width">
    <header><a href="/cave#notes">← Back to Cave</a><p class="eyebrow">Note · {date}</p><h1>{title}</h1><p>{description}</p></header>
    <div class="prose"><slot /></div>
  </article>
</SiteLayout>
<style is:global>
  .note{padding-block:clamp(7rem,12vw,11rem)}.note header{max-width:48rem;margin:0 auto;padding-bottom:3.5rem;border-bottom:1px solid var(--line)}.note header>a{display:inline-block;margin-bottom:5rem;color:var(--muted);font-size:.75rem}.note header h1{margin-top:1.1rem;font-size:clamp(3rem,7vw,6rem);line-height:.92;font-weight:500;letter-spacing:-.07em}.note header>p:last-child{max-width:36rem;margin-top:1.6rem;color:var(--muted);font-size:1.05rem;line-height:1.55}.prose{max-width:42rem;margin:3.5rem auto 0;font-size:1.04rem;line-height:1.78;color:#3f4141}.prose h2{margin:3rem 0 1rem;font-size:1.7rem;line-height:1.15;font-weight:540;letter-spacing:-.04em}.prose p+p{margin-top:1.45rem}.prose a{border-bottom:1px solid var(--metal)}
</style>
