---
const fallback = { commits: 128, repositories: 24, streak: 12, label: "Public activity" };
const detail = {
  eyebrow: "GitHub · @ilyastorunn",
  title: "Building in public.",
  description: "A compact view of recent public work. The live card updates through a cached Cloudflare endpoint and quietly falls back when GitHub is unavailable.",
  actionLabel: "Open GitHub",
  url: "https://github.com/ilyastorunn",
  accent: "#c8cbcd",
  meta: [{ label: "Profile", value: "@ilyastorunn" }, { label: "Data", value: "Public activity" }],
};
---
<a class="github-card small-card" href="https://github.com/ilyastorunn" data-detail={JSON.stringify(detail)} data-github-card data-reveal>
  <div class="github-head"><p class="eyebrow">GitHub activity</p><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.28-1.29-5.28-5.69 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.72 5.39-5.3 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg></div>
  <div class="activity-grid" aria-label="Recent contribution pattern">
    {Array.from({ length: 42 }, (_, index) => <i style={`--level:${(index * 7 + index % 5) % 4}`}></i>)}
  </div>
  <div class="github-stats"><strong data-github-value>{fallback.commits}</strong><span data-github-label>{fallback.label}</span><small data-github-state>Live when available</small></div>
</a>
<script>
  const cards = document.querySelectorAll<HTMLElement>("[data-github-card]");
  cards.forEach(async (card) => {
    const value = card.querySelector<HTMLElement>("[data-github-value]");
    const label = card.querySelector<HTMLElement>("[data-github-label]");
    const state = card.querySelector<HTMLElement>("[data-github-state]");
    try {
      const response = await fetch("/api/github.json", { signal: AbortSignal.timeout(4500) });
      if (!response.ok) throw new Error("GitHub response unavailable");
      const data = await response.json();
      if (value) value.textContent = String(data.recentEvents);
      if (label) label.textContent = "recent public events";
      if (state) state.textContent = `${data.publicRepos} public repositories`;
    } catch { if (state) state.textContent = "Showing a recent snapshot"; }
  });
</script>
<style>
  .github-card{display:flex;flex-direction:column;min-height:12.75rem;padding:1.05rem;border:1px solid var(--line);border-radius:var(--radius-card);background:#f8f8f6;transition:transform .25s ease,box-shadow .25s ease}.github-card:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(30,32,33,.08)}
  .github-head{display:flex;justify-content:space-between;align-items:center}.github-head svg{width:1.05rem}.activity-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:.18rem;margin-block:1.15rem .8rem}.activity-grid i{aspect-ratio:1;border-radius:2px;background:color-mix(in srgb,#222 calc(var(--level) * 22%),#e9eae7)}
  .github-stats{margin-top:auto;display:grid;grid-template-columns:auto 1fr;align-items:end;column-gap:.5rem}.github-stats strong{font-size:1.6rem;font-weight:480;line-height:.8;letter-spacing:-.06em}.github-stats span{font-size:.61rem;color:var(--muted)}.github-stats small{grid-column:1/-1;margin-top:.5rem;font: .51rem var(--font-mono);color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
  @media(max-width:500px){.github-card{min-height:13rem;padding:1rem}.activity-grid{gap:.15rem;margin-block:1rem .75rem}.github-stats{grid-template-columns:1fr}.github-stats strong{font-size:1.5rem}.github-stats span{font-size:.58rem}.github-head svg{width:1rem}}
</style>
