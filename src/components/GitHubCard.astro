---
const fallback = { commits: 128, repositories: 24, streak: 12, label: "Public activity" };
const detail = {
  eyebrow: "GitHub · @ilyastorunn",
  title: "Building in public.",
  description: "A live view of the last year of public work, fetched through a cached Cloudflare endpoint.",
  actionLabel: "Open GitHub",
  url: "https://github.com/ilyastorunn",
  accent: "#c8cbcd",
  meta: [{ label: "Profile", value: "@ilyastorunn" }, { label: "Data", value: "Public activity" }],
};
---
<a class="github-card small-card" href="https://github.com/ilyastorunn" data-detail={JSON.stringify(detail)} data-github-card data-reveal>
  <div class="github-head"><p class="eyebrow">GitHub activity</p><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.28-1.29-5.28-5.69 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.72 5.39-5.3 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg></div>
  <p class="contribution-total"><strong data-github-value>{fallback.commits}</strong><span data-github-label> recent public events</span></p>
  <div class="month-row" data-github-months aria-hidden="true"></div>
  <div class="activity-grid" data-github-grid role="img" aria-label="Loading GitHub contribution activity">
    {Array.from({ length: 364 }, (_, index) => <i data-level="0" style={`--cell-index:${index}`}></i>)}
  </div>
  <p class="repository-line" data-github-repositories>Fetching public activity…</p>
</a>
<script>
  const cards = document.querySelectorAll<HTMLElement>("[data-github-card]");
  cards.forEach(async (card) => {
    const value = card.querySelector<HTMLElement>("[data-github-value]");
    const label = card.querySelector<HTMLElement>("[data-github-label]");
    const grid = card.querySelector<HTMLElement>("[data-github-grid]");
    const months = card.querySelector<HTMLElement>("[data-github-months]");
    const repositories = card.querySelector<HTMLElement>("[data-github-repositories]");
    try {
      const response = await fetch("/api/github.json", { signal: AbortSignal.timeout(4500) });
      if (!response.ok) throw new Error("GitHub response unavailable");
      const data = await response.json();
      const contributions = Array.isArray(data.contributions) ? data.contributions.slice(-364) : [];
      if (!contributions.length) throw new Error("Contribution data unavailable");
      if (value) value.textContent = String(data.totalContributions);
      if (label) label.textContent = " contributions in the last year";
      if (grid) {
        grid.replaceChildren(...contributions.map((day: { date: string; count: number; level: number }, index: number) => {
          const cell = document.createElement("i");
          cell.dataset.level = String(day.level);
          cell.style.setProperty("--cell-index", String(index));
          cell.title = `${day.count} ${day.count === 1 ? "contribution" : "contributions"} on ${new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" }).format(new Date(`${day.date}T00:00:00`))}`;
          return cell;
        }));
        grid.setAttribute("aria-label", `${data.totalContributions} GitHub contributions in the last year`);
      }
      if (months) {
        const weeks = Array.from({ length: Math.ceil(contributions.length / 7) }, (_, index) => contributions.slice(index * 7, index * 7 + 7));
        let previousMonth = "";
        months.replaceChildren(...weeks.map((week) => {
          const month = week[0]?.date.slice(0, 7) ?? "";
          const item = document.createElement("span");
          if (month !== previousMonth && week.length) item.textContent = new Intl.DateTimeFormat("en", { month: "short" }).format(new Date(`${week[0].date}T00:00:00`));
          previousMonth = month;
          return item;
        }));
      }
      if (repositories) {
        const names = Array.isArray(data.topRepositories) ? data.topRepositories.map((repository: { name: string }) => repository.name) : [];
        repositories.textContent = names.length ? `Recently active · ${names.join(" · ")}` : `${data.publicRepos} public repositories`;
      }
    } catch { if (repositories) repositories.textContent = "Live activity temporarily unavailable"; }
  });
</script>
<style>
  .github-card{display:flex;flex-direction:column;min-height:12.75rem;padding:1.05rem;border:1px solid var(--line);border-radius:var(--radius-card);background:#f8f8f6;transition:transform .25s ease,box-shadow .25s ease}.github-card:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(30,32,33,.08)}
  .github-head{display:flex;justify-content:space-between;align-items:center}.github-head svg{width:1.05rem}.contribution-total{margin-top:.85rem;font-size:.65rem;color:var(--muted)}.contribution-total strong{font-size:1rem;font-weight:540;color:var(--ink);letter-spacing:-.04em}.month-row{display:grid;grid-template-columns:repeat(52,minmax(2px,1fr));gap:.13rem;height:.65rem;margin-top:.65rem;overflow:hidden}.month-row span{font:500 .42rem var(--font-mono);color:var(--muted);white-space:nowrap}.activity-grid{display:grid;grid-template-columns:repeat(52,minmax(2px,1fr));grid-template-rows:repeat(7,minmax(2px,1fr));grid-auto-flow:column;gap:.13rem;aspect-ratio:7.42;margin-top:.15rem}.activity-grid i{min-width:0;aspect-ratio:1;border-radius:1.5px;background:#e5e6e3;animation:cell-in .35s both;animation-delay:min(calc(var(--cell-index) * 2ms),.5s)}.activity-grid i[data-level="1"]{background:#bfc4c0}.activity-grid i[data-level="2"]{background:#929a94}.activity-grid i[data-level="3"]{background:#606a63}.activity-grid i[data-level="4"]{background:#28312b}.repository-line{margin-top:auto;padding-top:.65rem;overflow:hidden;color:var(--muted);font:500 .49rem var(--font-mono);text-overflow:ellipsis;white-space:nowrap;text-transform:uppercase;letter-spacing:.04em}@keyframes cell-in{from{opacity:0;transform:scale(.65)}to{opacity:1;transform:scale(1)}}
  @media(max-width:500px){.github-card{min-height:13rem;padding:1rem}.activity-grid,.month-row{gap:.11rem}.github-head svg{width:1rem}}
  @media(prefers-reduced-motion:reduce){.activity-grid i{animation:none}}
</style>
