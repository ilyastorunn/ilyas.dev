---
import type { CollectionEntry } from "astro:content";
interface Props { items: CollectionEntry<"music">[]; }
const { items } = Astro.props;
---
<section class="cave-section music" id="music" aria-labelledby="music-title" data-reveal>
  <div class="section-title"><p class="eyebrow">Listening</p><h2 id="music-title">Music</h2><p>Records that have been keeping the room company.</p></div>
  <div class="records">{items.map((item, index) => <a href={item.data.url ?? "#music"} target={item.data.url ? "_blank" : undefined} rel={item.data.url ? "noreferrer" : undefined}><div class="record-cover" style={`--record:${item.data.color};--ring:${index * 16 + 32}%`}><span>{item.data.title}</span><i></i></div><h3>{item.data.title}</h3><p>{item.data.artist} · {item.data.year}</p></a>)}</div>
</section>
<style>
  .cave-section{padding-block:clamp(5rem,9vw,8rem);border-top:1px solid var(--line)}.section-title{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:2.7rem}.section-title h2{margin-top:.7rem;font-size:clamp(2.2rem,4vw,4rem);font-weight:510;line-height:.95;letter-spacing:-.06em}.section-title>p{max-width:22rem;color:var(--muted);line-height:1.55;font-size:.86rem}.records{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}.records a{min-width:0}.record-cover{position:relative;aspect-ratio:1;overflow:hidden;border-radius:.35rem;background:var(--record);box-shadow:0 1rem 2rem rgba(34,36,36,.14);transition:transform .3s ease,box-shadow .3s}.records a:hover .record-cover{transform:translateY(-.3rem) rotate(-.4deg);box-shadow:0 1.5rem 2.5rem rgba(34,36,36,.17)}.record-cover span{position:absolute;z-index:2;left:8%;bottom:7%;max-width:75%;font-size:clamp(1rem,2.2vw,1.8rem);font-weight:600;line-height:.9;letter-spacing:-.06em}.record-cover i{position:absolute;right:-17%;top:-14%;width:86%;aspect-ratio:1;border-radius:50%;background:repeating-radial-gradient(circle,rgba(255,255,255,.08) 0 2px,rgba(20,20,20,.08) 3px 5px),radial-gradient(circle,transparent 0 12%,rgba(25,25,24,.18) 13% 42%,transparent 43%);}.records h3{margin-top:1rem;font-size:.95rem;font-weight:550}.records a>p{margin-top:.3rem;color:var(--muted);font-size:.7rem}
  @media(max-width:650px){.section-title{align-items:start;flex-direction:column}.records{grid-template-columns:1fr 1fr}.records a:last-child{display:none}}
</style>
