---
import type { CollectionEntry } from "astro:content";

interface Props {
  books: CollectionEntry<"books">[];
  preview?: boolean;
  heading?: string;
  description?: string;
}
const { books, preview = false, heading = "Bookshelf", description = "Books I return to, argue with, and keep within reach." } = Astro.props;
const shownBooks = preview ? books.filter((book) => book.data.selected).slice(0, 6) : books;
---

<section class:list={["bookshelf-section", { preview }]} aria-labelledby={`bookshelf-${preview ? "preview" : "full"}`} data-bookshelf data-reveal>
  <div class="bookshelf-heading">
    <div><p class="eyebrow">Collection</p><h2 id={`bookshelf-${preview ? "preview" : "full"}`}>{heading}</h2><p>{description}</p></div>
    {preview && <a href="/cave#bookshelf">Enter the Cave <span aria-hidden="true">↗</span></a>}
  </div>
  <div class="shelf-wrap">
    <button class="shelf-control previous" type="button" aria-label="Scroll books left">←</button>
    <div class="books" tabindex="0" aria-label="Book collection">
      {shownBooks.map((book, index) => {
        const { title, author, color, ink, height, note } = book.data;
        const detail = { eyebrow: "Bookshelf", title, description: note, accent: color, meta: [{ label: "Author", value: author }, { label: "Position", value: `${index + 1} of ${shownBooks.length}` }] };
        return (
          <button class="book" type="button" style={`--book-color:${color};--book-ink:${ink};--book-height:${height}px;--book-index:${index}`} data-detail={JSON.stringify(detail)} aria-label={`Open details for ${title} by ${author}`}>
            <span class="book-title">{title}</span>
            <span class="book-author">{author}</span>
            <i aria-hidden="true"></i>
          </button>
        );
      })}
    </div>
    <button class="shelf-control next" type="button" aria-label="Scroll books right">→</button>
    <div class="shelf-board" aria-hidden="true"><span></span></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-bookshelf]").forEach((shelf) => {
    const books = shelf.querySelector<HTMLElement>(".books");
    shelf.querySelector(".previous")?.addEventListener("click", () => books?.scrollBy({ left: -320, behavior: "smooth" }));
    shelf.querySelector(".next")?.addEventListener("click", () => books?.scrollBy({ left: 320, behavior: "smooth" }));
    books?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") books.scrollBy({ left: -180, behavior: "smooth" });
      if (event.key === "ArrowRight") books.scrollBy({ left: 180, behavior: "smooth" });
    });
  });
</script>

<style>
  .bookshelf-section { padding-block: clamp(5.5rem, 11vw, 10rem) clamp(4rem, 8vw, 7rem); }
  .bookshelf-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 3rem; }
  .bookshelf-heading h2 { margin-top: .7rem; font-size: clamp(2.2rem, 4vw, 4rem); line-height: .95; font-weight: 510; letter-spacing: -.06em; }
  .bookshelf-heading p:not(.eyebrow) { margin-top: 1rem; color: var(--muted); line-height: 1.5; }
  .bookshelf-heading a { flex: none; padding-bottom: .22rem; border-bottom: 1px solid var(--line); font-size: .82rem; }
  .shelf-wrap { position: relative; padding-inline: 2.7rem; }
  .books { position: relative; z-index: 2; display: flex; align-items: end; gap: clamp(.75rem, 1.8vw, 1.45rem); min-height: 18rem; overflow-x: auto; overscroll-behavior-inline: contain; scrollbar-width: none; scroll-snap-type: x proximity; padding: 1rem 1.2rem 1.5rem; }
  .books::-webkit-scrollbar { display: none; }
  .book { position: relative; flex: 0 0 clamp(6.1rem, 10vw, 8.2rem); height: var(--book-height); overflow: hidden; padding: .75rem .58rem; border: 1px solid color-mix(in srgb, var(--book-color), black 20%); border-radius: .25rem .45rem .18rem .18rem; background: var(--book-color); color: var(--book-ink); text-align: left; box-shadow: .38rem .65rem .9rem rgba(35,35,33,.17), inset 2px 0 rgba(255,255,255,.19), inset -3px 0 rgba(0,0,0,.08); transform: perspective(40rem) rotateY(calc((var(--book-index) - 2) * -.35deg)); transform-origin: bottom; scroll-snap-align: center; cursor: pointer; transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease; }
  .book:hover, .book:focus-visible { transform: translateY(-.7rem) rotateY(0); box-shadow: .5rem 1.25rem 1.5rem rgba(35,35,33,.19), inset 2px 0 rgba(255,255,255,.19), inset -3px 0 rgba(0,0,0,.08); }
  .book-title { display: block; font-size: clamp(.7rem, 1vw, .9rem); line-height: 1.02; font-weight: 650; letter-spacing: -.045em; overflow-wrap: anywhere; }
  .book-author { position: absolute; left: .58rem; right: .58rem; bottom: .7rem; font: 500 .43rem var(--font-mono); line-height: 1.25; text-transform: uppercase; letter-spacing: .05em; }
  .book i { position: absolute; right: -.8rem; top: 23%; width: 2.8rem; aspect-ratio: 1; border: .45rem solid color-mix(in srgb, var(--book-ink), transparent 55%); border-radius: 50%; }
  .shelf-board { position: absolute; z-index: 1; left: 1.4rem; right: 1.4rem; bottom: .1rem; height: 2rem; border: 1px solid #d4d4d1; border-radius: .25rem .25rem .65rem .65rem; background: linear-gradient(#f9f9f7 0 46%,#dedfdd 48%,#f5f5f3 70%); box-shadow: 0 1.1rem 1.6rem rgba(27,29,29,.13); }
  .shelf-board span { position:absolute;left:3%;right:3%;bottom:-.75rem;height:.65rem;border-radius:50%;background:rgba(40,42,42,.11);filter:blur(.5rem); }
  .shelf-control { position: absolute; z-index: 4; top: 52%; display:grid;place-items:center;width:2.4rem;aspect-ratio:1;border:1px solid var(--line);border-radius:50%;background:rgba(253,253,252,.88);backdrop-filter:blur(8px);cursor:pointer;color:var(--muted);transition:color .2s,border-color .2s,transform .2s; }
  .shelf-control:hover { color:var(--ink);border-color:#bbb;transform:scale(1.04); }.previous{left:0}.next{right:0}
  @media(max-width:700px){.bookshelf-heading{align-items:start;flex-direction:column}.shelf-wrap{padding-inline:0}.shelf-control{display:none}.books{padding-inline:.2rem}.shelf-board{left:-.5rem;right:-.5rem}}
</style>
