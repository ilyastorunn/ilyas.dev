---
import type { CollectionEntry } from "astro:content";

interface Props { project: CollectionEntry<"projects">; index: number; }
const { project, index } = Astro.props;
const { title, eyebrow, summary, accent, size, kind, detail } = project.data;
const payload = { ...detail, eyebrow, accent };
---

<a class:list={["project-card", `project-${size}`, `visual-${kind}`]} style={`--accent:${accent}`} href={detail.url ?? "#work"} data-detail={JSON.stringify(payload)} data-reveal>
  <div class="card-label"><span>{eyebrow}</span><span aria-hidden="true">↗</span></div>
  <div class="project-visual" aria-hidden="true">
    {kind === "app" ? (
      <div class="device">
        <div class="device-island"></div>
        <div class="app-screen">
          <span>{index === 0 ? "Thoughts" : "Today"}</span>
          <strong>{index === 0 ? "A quiet place for signal." : "72°"}</strong>
          <div><i></i><i></i><i></i></div>
        </div>
      </div>
    ) : (
      <div class="browser">
        <div class="browser-bar"><i></i><i></i><i></i></div>
        <div class="browser-page"><span>SWELL</span><b>Objects for<br/>slow mornings.</b><i></i></div>
      </div>
    )}
  </div>
  <div class="project-copy">
    <h2>{title}</h2>
    <p>{summary}</p>
  </div>
</a>

<style>
  .project-card { position: relative; display: flex; flex-direction: column; min-height: 20.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-card); background: linear-gradient(145deg, color-mix(in srgb, var(--accent), white 58%), color-mix(in srgb, var(--accent), white 82%)); box-shadow: inset 0 1px 0 rgba(255,255,255,.8); transition: transform .28s cubic-bezier(.22,.8,.22,1), box-shadow .28s ease; }
  .project-card:hover { transform: translateY(-2px); box-shadow: 0 18px 42px rgba(27,30,31,.09); }
  .card-label { position: absolute; inset: 1.05rem 1.1rem auto; z-index: 3; display: flex; justify-content: space-between; font: 500 .58rem var(--font-mono); letter-spacing: .09em; color: rgba(32,33,33,.66); }
  .project-visual { display: grid; place-items: center; flex: 1; min-height: 13.6rem; padding: 2.6rem 1.35rem .7rem; }
  .device { position: relative; width: clamp(6.4rem, 32%, 8.25rem); aspect-ratio: .52; padding: .29rem; border-radius: 1.4rem; background: linear-gradient(130deg,#46494a,#111 42%,#555); box-shadow: 0 1.35rem 2.1rem rgba(31,35,37,.22), inset 0 0 0 1px #777; transform: translateY(1.8rem) rotate(-2deg); transition: transform .45s cubic-bezier(.22,.8,.22,1); }
  .project-card:hover .device { transform: translateY(1.6rem) rotate(-1deg); }
  .device-island { position: absolute; z-index: 2; left: 50%; top: .85rem; width: 34%; height: .85rem; border-radius: 1rem; background: #090909; transform: translateX(-50%); }
  .app-screen { height: 100%; padding: 3.35rem .8rem .8rem; border-radius: 1.28rem; background: linear-gradient(175deg,rgba(255,255,255,.94),rgba(235,238,237,.92)); }
  .app-screen span { display: block; font: .58rem var(--font-mono); color: #737777; text-transform: uppercase; letter-spacing: .08em; }
  .app-screen strong { display: block; margin-top: .5rem; font-size: 1.05rem; font-weight: 520; line-height: 1.04; letter-spacing: -.05em; }
  .app-screen div { display: grid; gap: .34rem; margin-top: 1.05rem; }.app-screen i { height: 1.65rem; border: 1px solid #dcdfdd; border-radius: .5rem; background: rgba(255,255,255,.7); }
  .browser { width: 84%; aspect-ratio: 1.72; overflow: hidden; border: 1px solid rgba(42,44,44,.18); border-radius: .65rem; background: white; box-shadow: 0 1.4rem 2.3rem rgba(42,48,45,.16); transform: translate(6%, 1.5rem) rotate(1deg); transition: transform .45s cubic-bezier(.22,.8,.22,1); }
  .project-card:hover .browser { transform: translate(5%,1.15rem) rotate(.5deg); }
  .browser-bar { display: flex; gap: .24rem; align-items: center; height: 1.55rem; padding-left: .55rem; border-bottom: 1px solid #e6e6e3; }.browser-bar i { width: .32rem; aspect-ratio:1;border-radius:50%;background:#d6d7d4; }
  .browser-page { position: relative; height: calc(100% - 1.55rem); padding: 1.2rem; background: #efeee8; }.browser-page span { font: .48rem var(--font-mono);letter-spacing:.16em; }.browser-page b { display:block;margin-top:1.2rem;font-size:clamp(1rem,2vw,1.7rem);line-height:.96;letter-spacing:-.06em;font-weight:520; }.browser-page i { position:absolute;right:8%;bottom:-12%;width:42%;aspect-ratio:1;border-radius:50% 50% 44% 48%;background:#aab8b0;box-shadow:inset -20px -14px 25px rgba(54,70,60,.17); }
  .project-copy { position: relative; z-index: 2; padding: .9rem 1.1rem 1rem; border-top: 1px solid rgba(32,33,33,.08); background: rgba(253,253,252,.74); backdrop-filter: blur(14px); }
  .project-copy h2 { font-size: 1.04rem; font-weight: 540; letter-spacing: -.035em; }.project-copy p { margin-top: .24rem; max-width: 28rem; color: #686a6a; font-size: .71rem; line-height: 1.42; }
  .project-tall { min-height: 20.5rem; }
  .project-standard { min-height: 18.5rem; }
  @media (max-width: 720px) { .project-card, .project-tall, .project-standard { min-height: 21.5rem; } .device { width: 8.6rem; } }
</style>
