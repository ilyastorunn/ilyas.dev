---
import type { CollectionEntry } from "astro:content";
interface Props { items: CollectionEntry<"photography">[]; }
const { items } = Astro.props;
---
<section class="cave-section photography" id="photography" aria-labelledby="photography-title" data-reveal>
  <div class="section-intro"><p class="eyebrow">Looking</p><h2 id="photography-title">Photography</h2><p>Small studies in light, objects, and the space between places.</p></div>
  <div class="photo-grid">
    {items.map((item, index) => <figure class:list={[{ wide: index === 0 || index === 3 }]}><div class="photo" style={`--p1:${item.data.palette[0]};--p2:${item.data.palette[1]};--p3:${item.data.palette[2]}`}><i></i><span></span></div><figcaption><span>{item.data.title}</span><span>{item.data.location} · {item.data.year}</span></figcaption></figure>)}
  </div>
</section>
<style>
  .cave-section{padding-block:clamp(5rem,9vw,8rem);border-top:1px solid var(--line)}.section-intro{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:2rem;margin-bottom:2.7rem}.section-intro h2{margin-top:.7rem;font-size:clamp(2.2rem,4vw,4rem);font-weight:510;line-height:.95;letter-spacing:-.06em}.section-intro>p{justify-self:end;max-width:23rem;color:var(--muted);line-height:1.55;font-size:.86rem}
  .photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.photo-grid figure.wide{grid-column:span 2}.photo{position:relative;aspect-ratio:1.15;overflow:hidden;border-radius:var(--radius-card);background:linear-gradient(155deg,var(--p1),var(--p2) 52%,var(--p3));box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}.wide .photo{aspect-ratio:2.15}.photo i{position:absolute;left:12%;bottom:-9%;width:44%;height:68%;background:color-mix(in srgb,var(--p3),transparent 12%);clip-path:polygon(18% 0,100% 17%,78% 100%,0 84%);filter:blur(.4px)}.photo span{position:absolute;right:14%;top:12%;width:20%;aspect-ratio:1;border-radius:50%;background:color-mix(in srgb,var(--p2),white 35%);box-shadow:0 0 3rem color-mix(in srgb,var(--p2),white 40%)}figcaption{display:flex;justify-content:space-between;gap:1rem;margin-top:.7rem;font-size:.7rem}figcaption span:last-child{color:var(--muted);font-family:var(--font-mono);font-size:.58rem;text-transform:uppercase}
  @media(max-width:700px){.section-intro{grid-template-columns:1fr}.section-intro>p{justify-self:start}.photo-grid{grid-template-columns:1fr 1fr}.photo-grid figure,.photo-grid figure.wide{grid-column:span 1}.wide .photo,.photo{aspect-ratio:1}.photo-grid figure:first-child{grid-column:1/-1}.photo-grid figure:first-child .photo{aspect-ratio:1.6}}
</style>
