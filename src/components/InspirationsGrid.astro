---
import type { CollectionEntry } from "astro:content";
interface Props { items: CollectionEntry<"inspirations">[]; }
const { items } = Astro.props;
---
<section class="cave-section inspirations" id="inspirations" aria-labelledby="inspirations-title" data-reveal>
  <div class="section-title"><p class="eyebrow">References</p><h2 id="inspirations-title">Inspirations</h2></div>
  <div class="inspiration-grid">{items.map((item, index) => <article><span>{String(index + 1).padStart(2,"0")}</span><h3>{item.data.name}</h3><p>{item.data.field}</p><blockquote>{item.data.note}</blockquote></article>)}</div>
</section>
<style>
  .cave-section{display:grid;grid-template-columns:1fr 2fr;gap:clamp(2rem,7vw,8rem);padding-block:clamp(5rem,9vw,8rem);border-top:1px solid var(--line)}.section-title h2{margin-top:.7rem;font-size:clamp(2.2rem,4vw,4rem);font-weight:510;line-height:.95;letter-spacing:-.06em}.inspiration-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}article{position:relative;min-height:13rem;padding:1.3rem;border-bottom:1px solid var(--line)}article:nth-child(odd){border-right:1px solid var(--line)}article>span{font:.57rem var(--font-mono);color:var(--muted)}h3{margin-top:2rem;font-size:1.3rem;font-weight:540;letter-spacing:-.035em}article>p{margin-top:.25rem;color:var(--muted);font-size:.7rem}blockquote{position:absolute;left:1.3rem;right:1.3rem;bottom:1.3rem;font-size:.76rem;color:#5f6161}
  @media(max-width:760px){.cave-section{grid-template-columns:1fr}.inspiration-grid{grid-template-columns:1fr}article:nth-child(odd){border-right:0}}
</style>
