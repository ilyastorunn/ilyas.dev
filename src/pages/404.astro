---
import SiteLayout from "../layouts/SiteLayout.astro";
export const prerender = true;
---
<SiteLayout title="Not found — İlyas Torun" description="The requested page could not be found.">
  <section class="not-found content-width"><p class="eyebrow">404</p><h1>This object is<br/>not on the shelf.</h1><p>The page may have moved, or perhaps it never belonged here.</p><a href="/">Return home →</a></section>
</SiteLayout>
<style>.not-found{padding-block:clamp(8rem,16vw,15rem)}.not-found h1{margin-top:1rem;font-size:clamp(3rem,7vw,7rem);line-height:.88;font-weight:500;letter-spacing:-.075em}.not-found>p:not(.eyebrow){margin-top:2rem;color:var(--muted)}.not-found a{display:inline-block;margin-top:2rem;padding-bottom:.2rem;border-bottom:1px solid var(--line)}</style>
