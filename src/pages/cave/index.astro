---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Bookshelf from "../../components/Bookshelf.astro";
import PhotographyGrid from "../../components/PhotographyGrid.astro";
import UsesList from "../../components/UsesList.astro";
import NotesList from "../../components/NotesList.astro";
import MusicCollection from "../../components/MusicCollection.astro";
import InspirationsGrid from "../../components/InspirationsGrid.astro";
import DetailModal from "../../components/DetailModal.astro";

export const prerender = true;
const [books, photography, uses, notes, music, inspirations] = await Promise.all([
  getCollection("books"), getCollection("photography"), getCollection("uses"),
  getCollection("notes", ({ data }) => !data.draft), getCollection("music"), getCollection("inspirations"),
]);
notes.sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<SiteLayout title="Cave — İlyas Torun" description="Books, photographs, notes, music, tools, and references collected by İlyas Torun." current="cave">
  <section class="cave-hero content-width"><p class="eyebrow">The Cave</p><h1>A room for things that<br/>shape the work.</h1><p>Books, photographs, sounds, tools, and references collected without needing to become a portfolio project.</p><nav aria-label="Cave sections"><a href="#bookshelf">Bookshelf</a><a href="#photography">Photography</a><a href="#uses">Uses</a><a href="#notes">Notes</a><a href="#music">Music</a><a href="#inspirations">Inspirations</a></nav></section>
  <div class="content-width cave-content">
    <div id="bookshelf"><Bookshelf books={books} heading="The full shelf" description="A growing collection of books that changed how I look at products, people, and work." /></div>
    <PhotographyGrid items={photography} />
    <UsesList items={uses} />
    <NotesList notes={notes} />
    <MusicCollection items={music} />
    <InspirationsGrid items={inspirations} />
  </div>
  <DetailModal />
</SiteLayout>
<style>
  .cave-hero{padding-block:clamp(7rem,13vw,12rem) clamp(5rem,9vw,8rem)}.cave-hero h1{margin-top:1.2rem;max-width:50rem;font-size:clamp(3rem,7vw,7rem);line-height:.9;font-weight:500;letter-spacing:-.075em}.cave-hero>p:not(.eyebrow){max-width:35rem;margin-top:2rem;color:var(--muted);font-size:clamp(.9rem,1.4vw,1.08rem);line-height:1.65}.cave-hero nav{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:3rem}.cave-hero nav a{padding:.52rem .75rem;border:1px solid var(--line);border-radius:999px;font-size:.68rem;color:#555;transition:background .2s,color .2s}.cave-hero nav a:hover{background:var(--ink);color:white}.cave-content>div[id]{scroll-margin-top:2rem}
</style>
