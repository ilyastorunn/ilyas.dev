---
import { Image } from "astro:assets";
import "@fontsource-variable/instrument-sans";
import spiderVerseHero from "../assets/spider-verse-hero-2x.png";
import madvillainyCover from "../assets/madvillainy-cover.png";
import doctorDoomComic from "../assets/doctor-doom-comic.png";
import unscrollIcon from "../assets/unscroll-icon.jpg";
import mementoIcon from "../assets/memento-icon.jpg";

const title = "İlyas Torun — Independent Developer";
const email = "ilyastorun.dev@gmail.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="İlyas Torun is an independent developer designing and building thoughtful products for the web and Apple platforms."
    />
    <meta name="theme-color" content="#f1f2f3" />
    <title>{title}</title>
  </head>
  <body>
    <div class="card-stack">
      <section class="transition-stage" data-transition-stage>
        <div class="card-viewport" data-card-viewport>
        <div class="site-canvas stack-card hero-card" data-hero-card>
        <header class="site-header">
          <nav class="section-preview" aria-label="Portfolio sections">
            <a href="#work" data-card-link="0" aria-current="page">Work</a>
            <a href="#about" data-card-link="1">About</a>
            <span aria-disabled="true" title="Cave will be added as its card is designed">Cave</span>
          </nav>

          <a class="contact" href={`mailto:${email}`}>
            <span>Contact me</span>
            <span aria-hidden="true">↗</span>
          </a>
        </header>

        <main>
          <section class="hero" id="work" aria-labelledby="intro-title">
            <h1 id="intro-title" class="sr-only">
              Independent developer designing and building thoughtful products for the web and Apple platforms.
            </h1>

            <figure class="hero-visual">
              <Image
                src={spiderVerseHero}
                alt="Miles Morales suspended against an upside-down city skyline."
                widths={[480, 720, 960, 1200, 1600, 2400]}
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1520px) calc(100vw - 180px), 1270px"
                loading="eager"
                fetchpriority="high"
              />

              <figcaption class="comic-caption caption-one">
                That’s all it is,<br />İlyas.
              </figcaption>
              <figcaption class="comic-caption caption-two">
                Make something<br />beautiful.
              </figcaption>

              <div class="scroll-cue" aria-hidden="true">
                <span>swipe down, please :)</span>
                <svg viewBox="0 0 46 56" role="img">
                  <path d="M20 3c2 14 3 25 1 39" />
                  <path d="m9 33 12 11 14-10" />
                </svg>
              </div>
            </figure>
          </section>
        </main>
        </div>
        <div class="site-canvas stack-card about-card" id="about" data-about-card aria-labelledby="about-title">
          <div class="about-heading">
            <p class="about-kicker">The person behind the pixels</p>
            <div class="about-title-lockup">
              <h2 id="about-title">About!</h2>
              <span aria-hidden="true">issue no. 01</span>
            </div>
            <p class="about-doodle" aria-hidden="true">meet the human →</p>
          </div>

          <div class="about-bento">
            <article class="bento-panel story-panel">
              <p class="panel-label">The short version</p>
              <div class="story-text">
                <p class="story-copy">Hey, I’m Ilyas — a front-end developer building thoughtful things for the web.</p>
                <p class="story-detail">It started with a C++ class in 2018. Today I craft digital products, build my own ideas, and keep pushing the edges of what I can make.</p>
              </div>
              <span class="draft-stamp">Since 2018</span>
            </article>

            <article class="bento-panel github-panel" data-github-card>
              <div class="github-head">
                <div>
                  <p class="panel-label">GitHub activity</p>
                  <a href="https://github.com/ilyastorunn" target="_blank" rel="noreferrer">@ilyastorunn ↗</a>
                </div>
                <span class="github-total" data-github-total>Loading…</span>
              </div>
              <div class="contribution-grid" data-github-grid aria-label="Recent GitHub contributions">
                {Array.from({ length: 84 }, (_, index) => <i style={`--delay:${index}`} aria-hidden="true"></i>)}
              </div>
              <p class="github-status" data-github-status>Fetching the green squares.</p>
            </article>

            <article class="bento-panel music-panel" data-music-card>
              <Image
                class="doom-backdrop"
                src={doctorDoomComic}
                alt="Doctor Doom raising his fists beneath the words This land is mine."
                widths={[400, 800]}
                sizes="(max-width: 768px) 50vw, 25vw"
              />
              <div class="record" aria-hidden="true">
                <span class="record-label"><Image src={madvillainyCover} alt="" widths={[160, 300]} /></span>
                <span class="record-hole"></span>
              </div>
              <div class="music-copy">
                <p class="panel-value">All Caps</p>
                <p class="track-artist">MF DOOM</p>
              </div>
              <button class="play-button" type="button" data-music-toggle aria-label="Play All Caps preview" aria-pressed="false">▶</button>
              <audio data-music-audio preload="auto" src="https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/21/bc/bc/21bcbc11-adf7-1c11-ec7f-ca60bb54921d/mzaf_12993966015311248438.plus.aac.p.m4a"></audio>
            </article>

            <article class="bento-panel apps-panel" tabindex="0">
              <div class="apps-copy">
                <p class="panel-label">Three apps, one pocket</p>
                <p class="panel-value">Things I’ve made.</p>
              </div>
              <div class="app-stack" aria-label="Apps by İlyas Torun">
                <a class="app-sheet app-sheet-one" href="https://apps.apple.com/tr/app/unscroll-ekran-s%C3%BCresi/id6766120727?l=tr" target="_blank" rel="noreferrer">
                  <Image src={unscrollIcon} alt="Unscroll app icon" widths={[160]} />
                  <b>Unscroll</b><small>App Store ↗</small>
                </a>
                <a class="app-sheet app-sheet-two" href="https://apps.apple.com/tr/app/memento-takvim/id6757344347?l=tr" target="_blank" rel="noreferrer">
                  <Image src={mementoIcon} alt="Memento app icon" widths={[160]} />
                  <b>Memento</b><small>App Store ↗</small>
                </a>
                <span class="app-sheet app-sheet-three app-coming"><i>?</i><b>Next app</b><small>In review</small></span>
                <span class="app-pocket" aria-hidden="true"></span>
              </div>
            </article>

            <article class="bento-panel websites-panel">
              <div class="website-copy">
                <p class="panel-label">Selected websites</p>
                <p class="panel-value">A tiny browser deck.</p>
              </div>
              <div class="browser-deck" aria-label="Website carousel awaiting final projects">
                <div class="browser-card browser-card-back"><span></span></div>
                <div class="browser-card browser-card-mid"><span></span></div>
                <div class="browser-card browser-card-front">
                  <span><i></i><i></i><i></i></span>
                  <strong>Website preview</strong>
                </div>
              </div>
              <div class="deck-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            </article>
          </div>
        </div>
        </div>
      </section>
    </div>

    <script>
      const stage = document.querySelector<HTMLElement>("[data-transition-stage]");
      const viewport = document.querySelector<HTMLElement>("[data-card-viewport]");
      const heroCard = document.querySelector<HTMLElement>("[data-hero-card]");
      const aboutCard = document.querySelector<HTMLElement>("[data-about-card]");
      const cardLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-card-link]")];
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let previousActiveIndex = -1;

      const updateCards = () => {
        if (!stage || !viewport || !heroCard || !aboutCard) return;

        const travel = Math.max(stage.offsetHeight - window.innerHeight, 1);
        const progress = Math.min(Math.max(-stage.getBoundingClientRect().top / travel, 0), 1);
        const activeIndex = progress >= 0.55 ? 1 : 0;
        if (activeIndex !== previousActiveIndex) {
          previousActiveIndex = activeIndex;
          dispatchEvent(new CustomEvent("portfolio-card-change", { detail: { activeIndex } }));
        }
        cardLinks.forEach((link, index) => {
          if (index === activeIndex) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });

        if (reducedMotion.matches) {
          const showAbout = progress >= 0.5;
          heroCard.style.opacity = showAbout ? "0" : "1";
          aboutCard.style.transform = showAbout ? "translateY(0)" : "translateY(110%)";
          return;
        }

        const riseProgress = Math.min(Math.max((progress - 0.12) / 0.88, 0), 1);
        const easedRise = 1 - Math.pow(1 - riseProgress, 3);
        const fadeProgress = Math.min(Math.max((progress - 0.72) / 0.2, 0), 1);

        heroCard.style.transform = `translateY(${-18 * progress}px) scale(${1 - 0.09 * progress})`;
        heroCard.style.opacity = String(1 - fadeProgress);
        aboutCard.style.transform = `translateY(${(1 - easedRise) * 108}%)`;
      };

      let ticking = false;
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateCards();
          ticking = false;
        });
      };

      updateCards();
      addEventListener("scroll", requestUpdate, { passive: true });
      addEventListener("resize", requestUpdate);
      reducedMotion.addEventListener("change", requestUpdate);

      cardLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          if (!stage) return;
          event.preventDefault();
          const progress = Number(link.dataset.cardLink ?? 0);
          const travel = Math.max(stage.offsetHeight - window.innerHeight, 0);
          history.replaceState(null, "", link.hash);
          scrollTo({
            top: stage.offsetTop + travel * progress,
            behavior: reducedMotion.matches ? "auto" : "smooth",
          });
        });
      });

      const githubGrid = document.querySelector<HTMLElement>("[data-github-grid]");
      const githubTotal = document.querySelector<HTMLElement>("[data-github-total]");
      const githubStatus = document.querySelector<HTMLElement>("[data-github-status]");

      if (githubGrid && githubTotal && githubStatus) {
        fetch("https://github-contributions-api.jogruber.de/v4/ilyastorunn?y=last")
          .then((response) => {
            if (!response.ok) throw new Error("GitHub activity unavailable");
            return response.json();
          })
          .then((payload) => {
            const contributions = Array.isArray(payload.contributions)
              ? payload.contributions.slice(-84)
              : [];
            const cells = [...githubGrid.querySelectorAll<HTMLElement>("i")];
            contributions.forEach((day: { count?: number; date?: string; level?: number }, index: number) => {
              const cell = cells[index];
              if (!cell) return;
              cell.dataset.level = String(Math.min(Number(day.level ?? 0), 4));
              cell.title = `${day.count ?? 0} contributions on ${day.date ?? "this day"}`;
            });
            const total = Object.values(payload.total ?? {}).reduce(
              (sum: number, value) => sum + Number(value ?? 0),
              0,
            );
            githubTotal.textContent = `${total.toLocaleString()} this year`;
            githubStatus.textContent = "The last twelve weeks, live from GitHub.";
          })
          .catch(() => {
            githubTotal.textContent = "Public profile";
            githubStatus.textContent = "Activity is taking a coffee break.";
          });
      }

      const musicCard = document.querySelector<HTMLElement>("[data-music-card]");
      const musicToggle = document.querySelector<HTMLButtonElement>("[data-music-toggle]");
      const musicAudio = document.querySelector<HTMLAudioElement>("[data-music-audio]");

      if (musicCard && musicToggle && musicAudio) {
        musicAudio.volume = 0.5;
        let autoStartAttempted = false;
        let aboutIsActive = false;

        const setMusicState = (playing: boolean) => {
          musicCard.classList.toggle("is-playing", playing);
          musicToggle.textContent = playing ? "Ⅱ" : "▶";
          musicToggle.setAttribute("aria-pressed", String(playing));
          musicToggle.setAttribute("aria-label", playing ? "Pause All Caps preview" : "Play All Caps preview");
        };

        const tryAutoStart = async () => {
          if (autoStartAttempted || !aboutIsActive) return;
          autoStartAttempted = true;
          try {
            await musicAudio.play();
            setMusicState(true);
          } catch {
            autoStartAttempted = false;
          }
        };

        addEventListener("portfolio-card-change", ((event: CustomEvent<{ activeIndex: number }>) => {
          aboutIsActive = event.detail.activeIndex === 1;
          if (aboutIsActive) void tryAutoStart();
        }) as EventListener);

        const unlockPlayback = (event: Event) => {
          if ((event.target as Element | null)?.closest?.("[data-music-toggle]")) return;
          aboutIsActive = cardLinks[1]?.getAttribute("aria-current") === "page";
          if (aboutIsActive && musicAudio.paused) void tryAutoStart();
        };
        addEventListener("pointerdown", unlockPlayback, { passive: true });
        addEventListener("keydown", unlockPlayback);

        musicToggle.addEventListener("click", async () => {
          if (musicAudio.paused) {
            try {
              await musicAudio.play();
              setMusicState(true);
            } catch {
              setMusicState(false);
            }
          } else {
            musicAudio.pause();
            setMusicState(false);
          }
        });

        musicAudio.addEventListener("ended", () => setMusicState(false));
        musicAudio.addEventListener("pause", () => setMusicState(false));
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    min-width: 20rem;
    background: #f1f2f3;
    color: #161817;
    font-family: "Instrument Sans Variable", "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
  }

  :global(body) {
    min-height: 100svh;
    margin: 0;
  }

  :global(a) {
    color: inherit;
  }

  .card-stack {
    position: relative;
  }

  .transition-stage {
    position: relative;
    height: 220svh;
  }

  .card-viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    padding: clamp(0.75rem, 2.2vw, 2rem);
    overflow: hidden;
  }

  .stack-card {
    position: absolute;
    inset: clamp(0.75rem, 2.2vw, 2rem);
    transform-origin: 50% 8%;
    will-change: transform, opacity;
  }

  .hero-card {
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .about-card {
    z-index: 2;
    transform: translateY(108%);
  }

  .site-canvas {
    width: min(100%, 91rem);
    min-height: calc(100svh - clamp(1.5rem, 4.4vw, 4rem));
    margin-inline: auto;
    padding: clamp(1.4rem, 3.2vw, 3.6rem) clamp(1.35rem, 5vw, 6.5rem);
    overflow: hidden;
    border: 1px solid rgb(21 25 23 / 4%);
    border-radius: clamp(1.5rem, 3vw, 2.75rem);
    background: #fff;
    box-shadow: 0 1.5rem 5rem rgb(30 39 35 / 6%);
  }

  .hero-card {
    box-shadow: 0 2.4rem 6rem rgb(25 29 42 / 13%);
  }

  .about-card {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(1.25rem, 2vw, 2rem);
    padding-block: clamp(1.6rem, 3vw, 3rem);
    background: #e8e3f1;
    color: #312b3b;
    box-shadow: 0 1.75rem 5rem rgb(42 31 67 / 14%);
  }

  .about-heading {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
  }

  .about-kicker,
  .about-heading h2,
  .about-doodle,
  .panel-label,
  .panel-value,
  .story-copy,
  .github-status {
    margin: 0;
  }

  .about-kicker {
    grid-column: 1;
    color: #665e73;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .about-title-lockup {
    position: relative;
    grid-column: 1;
    width: fit-content;
    margin-top: 0.35rem;
    padding: 0.2rem 1.1rem 0.3rem 0.75rem;
    border: 3px solid #25202b;
    background: #ffd51c;
    box-shadow: 0.32rem 0.32rem 0 #13c5d9, 0.58rem 0.58rem 0 #e82d86;
    transform: rotate(-1deg);
  }

  .about-heading h2 {
    grid-column: 1;
    font-size: clamp(2.8rem, 5.4vw, 5.8rem);
    font-style: italic;
    font-weight: 820;
    letter-spacing: -0.07em;
    line-height: 0.82;
    text-transform: uppercase;
  }

  .about-title-lockup span {
    position: absolute;
    right: -2.2rem;
    bottom: -0.8rem;
    padding: 0.2rem 0.35rem;
    border: 1.5px solid #25202b;
    background: #fff;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.48rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(5deg);
  }

  .about-doodle {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    padding: 0.55rem 0.8rem;
    border: 2px solid #25202b;
    background: #ffd51c;
    box-shadow: 0.22rem 0.22rem 0 #13c5d9, 0.4rem 0.4rem 0 #e82d86;
    font-family: "Bradley Hand", "Marker Felt", "Comic Sans MS", cursive;
    font-size: clamp(0.78rem, 1vw, 1rem);
    font-weight: 700;
    transform: rotate(2deg);
  }

  .about-bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(0.7rem, 1.2vw, 1rem);
    min-height: 0;
  }

  .bento-panel {
    position: relative;
    min-width: 0;
    min-height: 0;
    padding: clamp(1rem, 1.65vw, 1.55rem);
    overflow: hidden;
    border: 1px solid rgb(49 43 59 / 12%);
    border-radius: clamp(1rem, 1.7vw, 1.5rem);
    background: rgb(255 255 255 / 74%);
  }

  .panel-label {
    color: #71697e;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .story-panel {
    display: flex;
    grid-column: span 5;
    grid-row: span 2;
    flex-direction: column;
    justify-content: space-between;
    background: #fff;
  }

  .story-copy {
    max-width: 12ch;
    font-size: clamp(1.45rem, 2.55vw, 2.8rem);
    font-weight: 430;
    letter-spacing: -0.052em;
    line-height: 1.02;
  }

  .story-text {
    display: grid;
    gap: clamp(0.9rem, 1.8vh, 1.4rem);
  }

  .story-detail {
    max-width: 42ch;
    margin: 0;
    color: #665e73;
    font-size: clamp(0.72rem, 0.9vw, 0.9rem);
    line-height: 1.45;
  }

  .draft-stamp {
    position: absolute;
    right: 1.2rem;
    bottom: 1.15rem;
    padding: 0.38rem 0.58rem;
    border: 2px solid #d53379;
    color: #d53379;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(-6deg);
  }

  .panel-value {
    max-width: 16ch;
    margin-top: 0.9rem;
    font-size: clamp(1.25rem, 2vw, 2rem);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .github-panel {
    display: flex;
    grid-column: span 4;
    gap: clamp(0.65rem, 1.2vh, 0.95rem);
    flex-direction: column;
    justify-content: flex-start;
    background: #25202b;
    color: #fff;
  }

  .github-panel .panel-label,
  .github-status {
    color: #bdb5c8;
  }

  .github-head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .github-head a {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
  }

  .github-total,
  .github-status {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    font-size: 0.55rem;
  }

  .github-status {
    line-height: 1.35;
  }

  .github-total {
    color: #ffd51c;
    white-space: nowrap;
  }

  .contribution-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 1fr);
    gap: clamp(2px, 0.32vw, 4px);
    width: 100%;
    margin-block: auto;
  }

  .contribution-grid i {
    aspect-ratio: 1;
    border-radius: 2px;
    background: #3e3944;
    transition: background 180ms ease, transform 180ms ease;
  }

  .contribution-grid i[data-level="1"] { background: #817f45; }
  .contribution-grid i[data-level="2"] { background: #b5b83f; }
  .contribution-grid i[data-level="3"] { background: #d9df36; }
  .contribution-grid i[data-level="4"] { background: #f3ff45; }
  .contribution-grid i:hover { transform: scale(1.4); }

  .music-panel {
    grid-column: span 3;
    background: #0b777f;
    color: #fff;
    isolation: isolate;
  }

  .doom-backdrop {
    position: absolute;
    z-index: -3;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    filter: saturate(0.9) contrast(1.02);
  }

  .music-panel::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: inherit;
    content: "";
    pointer-events: none;
  }

  .record {
    position: absolute;
    right: -38%;
    bottom: -36%;
    width: min(108%, 17.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, transparent 0 8%, rgb(3 4 4 / 94%) 8.4% 9.3%, transparent 9.7%),
      repeating-radial-gradient(circle at 50% 50%, transparent 0 2px, rgb(255 255 255 / 7%) 2.5px 3px, transparent 3.5px 6px),
      conic-gradient(from 20deg, #080909, #202322 8%, #080909 20%, #2a2d2c 30%, #090a0a 43%, #212423 57%, #070808 70%, #292c2b 84%, #080909);
    border: 1px solid rgb(255 255 255 / 18%);
    box-shadow:
      -0.75rem -0.55rem 1.4rem rgb(255 255 255 / 9%),
      0.9rem 1.2rem 2.2rem rgb(0 0 0 / 54%);
    animation: record-spin 9s linear infinite;
    animation-play-state: paused;
  }

  .music-panel.is-playing .record { animation-play-state: running; }

  .record::before,
  .record::after {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    content: "";
  }

  .record::before {
    background: linear-gradient(112deg, transparent 15%, rgb(255 255 255 / 13%) 27%, transparent 39% 67%, rgb(255 255 255 / 8%) 76%, transparent 88%);
