---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProfileCard from "../components/ProfileCard.astro";
import GitHubCard from "../components/GitHubCard.astro";
import MusicCard from "../components/MusicCard.astro";
import Bookshelf from "../components/Bookshelf.astro";
import DetailModal from "../components/DetailModal.astro";

export const prerender = true;
const projects = await getCollection("projects");
const books = await getCollection("books");
const projectById = Object.fromEntries(projects.map((project) => [project.id, project]));
---

<SiteLayout>
  <section class="hero content-width" aria-labelledby="intro-title">
    <div>
      <h1 id="intro-title">Independent developer crafting thoughtful digital products,<br class="desktop-break"/> useful tools and small experiments for the web and Apple platforms.</h1>
      <a class="availability" href="mailto:ilyastorun.dev@gmail.com"><i aria-hidden="true"></i><span>OPEN TO INTERESTING IDEAS</span></a>
    </div>
    <p class="hero-note">Based in Türkiye<br/>Working independently</p>
  </section>

  <section class="work content-width" id="work" aria-labelledby="work-title">
    <div class="work-heading" data-reveal><div><p class="eyebrow">Selected work</p><h2 id="work-title">Things made with care.</h2></div><p>Products, experiments, and a little context<br/>from the workbench.</p></div>
    <div class="bento-grid">
      <div class="grid-signal"><ProjectCard project={projectById.signal} index={0} /></div>
      <div class="grid-meter"><ProjectCard project={projectById.meter} index={1} /></div>
      <div class="grid-swell"><ProjectCard project={projectById.swell} index={2} /></div>
      <div class="grid-profile" id="about"><ProfileCard /></div>
      <div class="grid-github"><GitHubCard /></div>
      <div class="grid-music"><MusicCard /></div>
    </div>
  </section>

  <div class="content-width"><Bookshelf books={books} preview /></div>
  <DetailModal />
</SiteLayout>

<style>
  .hero { display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3rem;align-items:end;padding-block:clamp(6.8rem,12vw,11rem) clamp(6rem,10vw,9rem); }
  .hero h1 { max-width: 48rem; font-size: clamp(1.28rem, 2.05vw, 1.82rem); line-height: 1.48; font-weight: 430; letter-spacing: -.03em; }
  .availability { display:inline-flex;align-items:center;gap:.65rem;margin-top:2rem;padding:.48rem .8rem;border:1px solid var(--line);border-radius:999px;font:500 .62rem var(--font-mono);letter-spacing:.1em;transition:border-color .2s,transform .2s}.availability:hover{border-color:#bdbfbe;transform:translateY(-1px)}.availability i{width:.48rem;aspect-ratio:1;border-radius:50%;background:var(--amber);box-shadow:0 0 0 .22rem rgba(242,163,15,.12)}
  .hero-note { color:var(--muted);font: .65rem/1.7 var(--font-mono);text-align:right;text-transform:uppercase;letter-spacing:.06em; }
  .work { scroll-margin-top: 4rem; }
  .work-heading { display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2.4rem; }.work-heading h2{margin-top:.75rem;font-size:clamp(2.2rem,4vw,4rem);line-height:.95;font-weight:510;letter-spacing:-.06em}.work-heading>p{max-width:23rem;color:var(--muted);font-size:.83rem;line-height:1.55;text-align:right}
  .bento-grid { display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:auto auto auto;gap:clamp(.8rem,1.5vw,1.2rem); }
  .bento-grid>div{min-width:0}.bento-grid>div>:global(*){height:100%}.grid-signal{grid-column:1/9;grid-row:1}.grid-meter{grid-column:9/13;grid-row:1/3}.grid-swell{grid-column:1/9;grid-row:2}.grid-profile{grid-column:1/5;grid-row:3}.grid-github{grid-column:5/9;grid-row:3}.grid-music{grid-column:9/13;grid-row:3}
  @media(max-width:980px){.bento-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto}.grid-signal,.grid-meter,.grid-swell{grid-column:1/-1;grid-row:auto}.grid-profile{grid-column:1;grid-row:auto}.grid-github{grid-column:2;grid-row:auto}.grid-music{grid-column:1;grid-row:auto}}
  @media(max-width:720px){.hero{grid-template-columns:1fr;align-items:start;padding-top:6.8rem}.hero-note{display:none}.desktop-break{display:none}.work-heading{align-items:start;flex-direction:column}.work-heading>p{text-align:left}.grid-music{grid-column:1/-1}}
  @media(max-width:350px){.grid-profile,.grid-github,.grid-music{grid-column:1/-1}}
</style>
