  .shelf-plank { position: absolute; z-index: 4; right: 0; bottom: 5%; left: 0; display: block; height: 18%; border: 1px solid #2f1c12; background: repeating-linear-gradient(7deg, transparent 0 8px, rgb(54 28 15 / 15%) 9px 10px), linear-gradient(#97653f, #623b24 63%, #432617 64%); box-shadow: inset 0 2px rgb(255 235 187 / 20%); transform: rotateX(50deg); transform-origin: top; }
