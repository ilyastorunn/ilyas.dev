---
import { Image } from "astro:assets";
import "@fontsource-variable/instrument-sans";
import spiderManComic from "../assets/spider-man-artgerm.webp";
import cyclopsComic from "../assets/cyclops-comic.png";
import cerebroScanner from "../assets/cerebro-scanner-original.png";
import madvillainyCover from "../assets/madvillainy-cover.png";
import doctorDoomComic from "../assets/doctor-doom-comic.png";
import galactusStation from "../assets/galactus-space-station-ff49.webp";
import reedRichardsWork from "../assets/reed-richards-work.jpg";
import unscrollIcon from "../assets/unscroll-icon.jpg";
import mementoIcon from "../assets/memento-icon.jpg";
import steveJobsFront from "../assets/books/final/steve-jobs-front.webp";
import steveJobsBack from "../assets/books/final/steve-jobs-back.webp";
import steveJobsSpine from "../assets/books/final/steve-jobs-spine.webp";
import pixarBeyondFront from "../assets/books/final/pixar-beyond-front.webp";
import pixarBeyondBack from "../assets/books/final/pixar-beyond-back.webp";
import pixarBeyondSpine from "../assets/books/final/pixar-beyond-spine.webp";
import creativeActFront from "../assets/books/final/creative-act-front.webp";
import creativeActBack from "../assets/books/final/creative-act-back.webp";
import creativeActSpine from "../assets/books/final/creative-act-spine.webp";
import pressResetFront from "../assets/books/final/press-reset-front.webp";
import pressResetBack from "../assets/books/final/press-reset-back.webp";
import pressResetSpine from "../assets/books/final/press-reset-spine.webp";
import hitchhikersGuideFront from "../assets/books/final/hitchhikers-guide-front.webp";
import hitchhikersGuideBack from "../assets/books/final/hitchhikers-guide-back.webp";
import hitchhikersGuideSpine from "../assets/books/final/hitchhikers-guide-spine.webp";
import theOdysseyPoster from "../assets/films/the-odyssey.png";
import ladiesFirstPoster from "../assets/films/ladies-first.png";
import theDramaPoster from "../assets/films/the-drama.png";
import martySupremePoster from "../assets/films/marty-supreme.png";
import theTwoPopesPoster from "../assets/films/the-two-popes.png";
import theZoneOfInterestPoster from "../assets/films/the-zone-of-interest.png";
import aboutEllyPoster from "../assets/films/about-elly.png";
import nightWatchPhoto from "../assets/photos/night-watch.jpeg";
import passingByPhoto from "../assets/photos/passing-by.jpeg";
import slowAfternoonPhoto from "../assets/photos/slow-afternoon.jpeg";
import coldplayPhoto from "../assets/photos/coldplay.png";
import lookingUpPhoto from "../assets/photos/looking-up.jpeg";
import afterClosingPhoto from "../assets/photos/after-closing.jpeg";
import forTheLovePhoto from "../assets/photos/for-the-love.jpeg";
import goldenHourPhoto from "../assets/photos/golden-hour.jpeg";
import wideEyesPhoto from "../assets/photos/wide-eyes.jpeg";
import macbookProImage from "../assets/tech/macbook-pro.png";
import codexIcon from "../assets/tech/codex.png";
import cursorIcon from "../assets/tech/cursor.png";

const shelfBooks = [
  { slug: "jobs", title: "Steve Jobs", author: "Walter Isaacson", front: steveJobsFront, back: steveJobsBack, spine: steveJobsSpine, height: "94%", width: "10%", rotation: "-3deg", depth: "clamp(0.84rem, 1.3vw, 1.18rem)", previewScale: "1" },
  { slug: "creative", title: "Yaratıcı Eylem", author: "Rick Rubin", front: creativeActFront, back: creativeActBack, spine: creativeActSpine, height: "86%", width: "6.2%", rotation: "-1deg", depth: "clamp(0.52rem, 0.8vw, 0.72rem)", previewScale: "0.91" },
  { slug: "pixar", title: "Pixar ve Ötesine", author: "Lawrence Levy", front: pixarBeyondFront, back: pixarBeyondBack, spine: pixarBeyondSpine, height: "86%", width: "8.8%", rotation: "2deg", depth: "clamp(0.74rem, 1.14vw, 1.02rem)", previewScale: "0.91" },
  { slug: "reset", title: "Reset At", author: "Jason Schreier", front: pressResetFront, back: pressResetBack, spine: pressResetSpine, height: "80%", width: "7.4%", rotation: "0deg", depth: "clamp(0.64rem, 0.98vw, 0.88rem)", previewScale: "0.84" },
  { slug: "hitchhikers", title: "Otostopçunun Galaksi Rehberi", author: "Douglas Adams", front: hitchhikersGuideFront, back: hitchhikersGuideBack, spine: hitchhikersGuideSpine, height: "90%", width: "11.5%", rotation: "3deg", depth: "clamp(0.95rem, 1.5vw, 1.35rem)", previewScale: "0.96" },
];

const watchedFilms = [
  { title: "The Odyssey", rating: 4, poster: theOdysseyPoster },
  { title: "Ladies First", rating: 1, poster: ladiesFirstPoster },
  { title: "The Drama", rating: 3.5, poster: theDramaPoster },
  { title: "Marty Supreme", rating: 3.5, poster: martySupremePoster },
  { title: "The Two Popes", rating: 4, poster: theTwoPopesPoster },
  { title: "The Zone of Interest", rating: 3.5, poster: theZoneOfInterestPoster },
  { title: "About Elly", rating: 3.5, poster: aboutEllyPoster },
];

const cavePhotos = [
  { image: passingByPhoto, note: "They’re watching us.", place: "Konya, Türkiye", position: "top" },
  { image: nightWatchPhoto, note: "Always watching.", place: "Konya, Türkiye", position: "bottom" },
  { image: forTheLovePhoto, note: "For the love of butts.", place: "Home", position: "bottom" },
  { image: slowAfternoonPhoto, note: "No plans today.", place: "A slow afternoon", position: "top" },
  { image: lookingUpPhoto, note: "Look up more often.", place: "İstanbul, Türkiye", position: "bottom" },
  { image: goldenHourPhoto, note: "The light found a way in.", place: "Golden hour", position: "top" },
  { image: afterClosingPhoto, note: "After closing.", place: "İstanbul, Türkiye", position: "top" },
  { image: coldplayPhoto, note: "A little planet in a stadium.", place: "Coldplay", position: "bottom" },
  { image: wideEyesPhoto, note: "Those eyes.", place: "Home", position: "top" },
];

const title = "İlyas Torun — Independent Developer";
const email = "ilyastorun.dev@gmail.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="İlyas Torun is an independent developer designing and building thoughtful products for the web and Apple platforms."
    />
    <meta name="theme-color" content="#f1f2f3" />
    <title>{title}</title>
  </head>
  <body>
    <div class="card-stack">
      <section class="transition-stage" data-transition-stage>
        <div class="card-viewport" data-card-viewport>
        <div class="site-canvas stack-card hero-card" data-hero-card>
        <header class="site-header">
          <nav class="section-preview" aria-label="Portfolio sections">
            <a href="#work" data-card-link="0" aria-current="page">Home</a>
            <a href="#about" data-card-link="0.5">About me</a>
            <a href="#cave" data-card-link="1">Cave</a>
          </nav>

          <a class="contact" href={`mailto:${email}`}>
            <span>Contact me</span>
            <span aria-hidden="true">↗</span>
          </a>
        </header>

        <main>
          <section class="hero" aria-labelledby="intro-title">
            <h1 id="intro-title" class="sr-only">
              Independent developer designing and building thoughtful products for the web and Apple platforms.
            </h1>

            <figure class="hero-visual">
              <Image
                src={spiderManComic}
                alt="Spider-Man reaches toward the viewer between New York skyscrapers."
                widths={[480, 720, 960, 1200, 1600, 2400]}
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1520px) calc(100vw - 180px), 1270px"
                quality="high"
                loading="eager"
                fetchpriority="high"
              />

              <div class="hero-dialogue" aria-label="Welcome message from İlyas">
                <p class="speech-bubble speech-one">Hey, I’m İlyas.</p>
                <p class="speech-bubble speech-two">I build thoughtful products for web &amp; iOS.</p>
                <p class="speech-bubble speech-three">Welcome to my little corner of the internet.</p>
              </div>
            </figure>

            <div class="scroll-cue" aria-hidden="true">
              <span>swipe down, please :)</span>
              <svg viewBox="0 0 46 56" role="img">
                <path d="M20 3c2 14 3 25 1 39" />
                <path d="m9 33 12 11 14-10" />
              </svg>
            </div>
          </section>
        </main>
        </div>
        <div class="site-canvas stack-card about-card" data-about-card aria-labelledby="about-title">
          <div class="about-heading">
            <p class="about-kicker">The person behind the pixels</p>
            <div class="about-title-lockup">
              <h2 id="about-title">About!</h2>
              <span aria-hidden="true">issue no. 01</span>
            </div>
            <p class="about-doodle" aria-hidden="true">meet the human →</p>
          </div>

          <div class="about-bento">
            <article class="bento-panel story-panel">
              <Image
                class="cyclops-backdrop"
                src={cyclopsComic}
                alt=""
                widths={[480, 720, 960]}
                sizes="(max-width: 768px) calc(100vw - 40px), 40vw"
                quality="mid"
                aria-hidden="true"
              />
              <div class="story-caption story-origin">
                <span>Origin story</span>
                <p>It started with a C++ class in 2018.</p>
              </div>
              <div class="story-caption story-intro">
                <p>Hey, I’m Ilyas — an independent developer building thoughtful products for the web and iOS.</p>
              </div>
              <div class="story-caption story-now">
                <span>Meanwhile, today…</span>
                <p>I craft digital products, build my own ideas, and keep pushing what I can make.</p>
              </div>
            </article>

            <article class="bento-panel github-panel" data-github-card>
              <Image
                class="cerebro-backdrop"
                src={cerebroScanner}
                alt=""
                widths={[720, 1200, 1800]}
                sizes="(max-width: 768px) calc(100vw - 40px), 32vw"
                quality="mid"
                aria-hidden="true"
              />
              <div class="github-head">
                <a class="github-title-card" href="https://github.com/ilyastorunn" target="_blank" rel="noreferrer">
                  ilyastorunn’s GitHub Activity! <span aria-hidden="true">↗</span>
                </a>
                <span class="github-total" data-github-total>Loading…</span>
              </div>
              <div class="activity-scanner">
                <div class="contribution-grid" data-github-grid aria-label="Recent GitHub contributions">
                  {Array.from({ length: 112 }, (_, index) => <i style={`--delay:${index}`} aria-hidden="true"></i>)}
                </div>
              </div>
            </article>

            <article class="bento-panel music-panel" data-music-card>
              <Image
                class="doom-backdrop"
                src={doctorDoomComic}
                alt="Doctor Doom raising his fists beneath the words This land is mine."
                widths={[400, 800]}
                sizes="(max-width: 768px) 50vw, 25vw"
                quality="mid"
              />
              <div class="record" aria-hidden="true">
                <span class="record-label"><Image src={madvillainyCover} alt="" widths={[96, 160]} sizes="86px" quality="mid" /></span>
                <span class="record-hole"></span>
              </div>
              <div class="music-copy">
                <p class="panel-value">All Caps</p>
                <p class="track-artist">MF DOOM</p>
              </div>
              <button class="play-button" type="button" data-music-toggle aria-label="Play All Caps preview" aria-pressed="false">▶</button>
              <audio data-music-audio preload="none" src="https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/21/bc/bc/21bcbc11-adf7-1c11-ec7f-ca60bb54921d/mzaf_12993966015311248438.plus.aac.p.m4a"></audio>
            </article>

            <article class="bento-panel apps-panel">
              <Image
                class="app-comic-backdrop"
                src={galactusStation}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(max-width: 768px) 50vw, 25vw"
                quality="mid"
                aria-hidden="true"
              />
              <div class="apps-copy">
                <p class="panel-label">Three apps, one pocket</p>
                <p class="panel-value">Things I’ve made.</p>
              </div>
              <div class="app-launchers" aria-label="Apps by İlyas Torun">
                <a class="app-launcher app-launcher-one" href="https://apps.apple.com/tr/app/unscroll-ekran-s%C3%BCresi/id6766120727?l=tr" target="_blank" rel="noreferrer" aria-label="Open Unscroll on the App Store">
                  <span class="app-icon"><Image src={unscrollIcon} alt="" widths={[64, 120]} sizes="40px" quality="mid" /></span>
                  <span class="app-info"><b>Unscroll</b><small>Screen time, reclaimed. ↗</small></span>
                </a>
                <a class="app-launcher app-launcher-two" href="https://apps.apple.com/tr/app/memento-takvim/id6757344347?l=tr" target="_blank" rel="noreferrer" aria-label="Open Memento on the App Store">
                  <span class="app-icon"><Image src={mementoIcon} alt="" widths={[64, 120]} sizes="40px" quality="mid" /></span>
                  <span class="app-info"><b>Memento</b><small>Your calendar, remembered. ↗</small></span>
                </a>
                <span class="app-launcher app-launcher-three" tabindex="0" aria-label="Next app, currently in review">
                  <span class="app-icon"><i>?</i></span>
                  <span class="app-info"><b>Next app</b><small>Currently in review.</small></span>
                </span>
              </div>
            </article>

            <article class="bento-panel websites-panel">
              <Image
                class="workshop-backdrop"
                src={reedRichardsWork}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(max-width: 768px) calc(100vw - 40px), 34vw"
                quality="mid"
                aria-hidden="true"
              />
              <div class="website-headline">
                <p>What I’m building nowadays!</p>
              </div>
              <div class="live-preview" tabindex="0">
                <iframe src="https://screen-studio.pages.dev/" title="Live preview of Screen Studio" loading="lazy"></iframe>
                <span class="preview-screen" aria-hidden="true">
                  <b>Screen Studio</b>
                  <small>Hover for the live report →</small>
                </span>
                <span class="preview-scroll-hint" aria-hidden="true">scroll ↓</span>
              </div>
            </article>
          </div>
        </div>
        <div class="site-canvas stack-card cave-card" data-cave-card aria-labelledby="cave-title">
          <header class="cave-heading">
            <div class="cave-title-lockup"><h2 id="cave-title">Cave!</h2></div>
          </header>

          <div class="cave-board-wrap">
          <div class="cave-board" data-cave-board aria-label="A movable personal archive board">
            <section class="board-cluster books-cluster" data-drag-item tabindex="0" aria-label="Books shelf. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="mini-shelf" aria-hidden="true">
                <div class="shelf-books">
                  {shelfBooks.map((book) => (
                    <button
                      class={`real-book book-${book.slug}`}
                      type="button"
                      style={`--h:${book.height};--w:${book.width};--r:${book.rotation};--book-depth:${book.depth};--preview-scale:${book.previewScale}`}
                      aria-label={`Show ${book.title} by ${book.author} in 3D`}
                      aria-pressed="false"
                      data-book-button
                      data-no-drag
                    >
                      <Image class="shelf-spine-photo" src={book.spine} alt="" loading="lazy" widths={[40, 80, 120]} sizes="(max-width: 768px) 28px, 36px" quality="mid" />
                      <template data-book-preview-template>
                        <span class="book-preview" aria-hidden="true">
                          <span class="book-model">
                            <span class="book-face book-front"><Image src={book.front} alt="" loading="eager" widths={[160, 240, 320]} sizes="(max-width: 768px) 112px, 152px" quality="mid" /></span>
                            <span class="book-face book-back"><Image src={book.back} alt="" loading="eager" widths={[160, 240, 320]} sizes="(max-width: 768px) 112px, 152px" quality="mid" /></span>
                            <span class="book-face book-spine"><Image src={book.spine} alt="" loading="eager" widths={[40, 80, 120]} sizes="24px" quality="mid" /></span>
                            <span class="book-pages"></span>
                          </span>
                          <strong>{book.title}</strong>
                        </span>
                      </template>
                    </button>
                  ))}
                </div>
                <b class="shelf-plank"></b>
              </div>
              <ul class="sr-only">
                <li>Steve Jobs by Walter Isaacson</li>
                <li>The Creative Act: A Way of Being by Rick Rubin</li>
                <li>To Pixar and Beyond by Lawrence Levy</li>
                <li>Press Reset: Ruin and Recovery in the Video Game Industry by Jason Schreier</li>
                <li>The Hitchhiker's Guide to the Galaxy by Douglas Adams</li>
              </ul>
            </section>

            <section class="board-cluster films-cluster" data-drag-item tabindex="0" aria-label="Recently watched films. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="film-strip">
                <div class="film-strip-track">
                  {[0, 1].map((copyIndex) => watchedFilms.map((film, index) => (
                    <i
                      class="film-frame"
                      style={`--frame:${index}`}
                      aria-label={copyIndex === 0 ? `${film.title}, rated ${film.rating} out of 5` : undefined}
                      aria-hidden={copyIndex === 1 ? "true" : undefined}
                      data-film-frame
                      data-film-title={film.title}
                      data-film-rating={film.rating}
                    >
                      <Image src={film.poster} alt="" loading="lazy" widths={[96, 160, 240]} sizes="(max-width: 768px) 68px, 102px" quality="mid" />
                      <span>{String(index + 1).padStart(2, "0")}</span>
                    </i>
                  )))}
                </div>
              </div>
              <div class="film-hover-preview" data-film-hover-preview aria-hidden="true">
                <img data-film-preview-image alt="" />
                <span class="film-stars" aria-hidden="true">
                  {Array.from({ length: 5 }, () => <i>★</i>)}
                </span>
              </div>
            </section>

            <section class="board-cluster photos-cluster" data-drag-item tabindex="0" aria-label="Photograph stamp sheet. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="stamp-sheet">
                {cavePhotos.map((photo, index) => (
                  <button
                    class={`photo-stamp stamp-${index + 1} note-${photo.position}`}
                    type="button"
                    style={`--stamp:${index}`}
                    aria-label={`${photo.note} ${photo.place}`}
                    data-photo-open
                    data-no-drag
                  >
                    <span class="stamp-photo">
                      <Image class="stamp-image" src={photo.image} alt="" loading="lazy" widths={[120, 180, 240]} sizes="(max-width: 768px) 72px, 90px" quality="mid" />
                      <span class="stamp-note"><b>{photo.note}</b><em>{photo.place}</em></span>
                    </span>
                    <small><b>{String(index + 1).padStart(2, "0")}</b><em>ILYAS · 2026</em></small>
                  </button>
                ))}
              </div>
              <button class="photos-collapse" type="button" data-photo-collapse data-no-drag aria-label="Close enlarged photographs">×</button>
            </section>

            <section class="board-cluster tech-cluster" data-drag-item tabindex="0" aria-label="Technology stack. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="tech-stack" aria-hidden="true">
                <i class="tech-macbook"><Image src={macbookProImage} alt="" loading="lazy" widths={[240, 360, 480]} sizes="(max-width: 768px) 220px, 320px" quality="mid" /></i>
                <i class="tech-codex"><Image src={codexIcon} alt="" loading="lazy" widths={[96, 160, 240]} sizes="(max-width: 768px) 100px, 140px" quality="mid" /></i>
                <i class="tech-cursor"><Image src={cursorIcon} alt="" loading="lazy" widths={[96, 160, 240]} sizes="(max-width: 768px) 96px, 132px" quality="mid" /></i>
              </div>
            </section>

            <section class="board-cluster inspiration-cluster" data-drag-item tabindex="0" aria-label="Inspiration fragments. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="inspiration-fragments" aria-hidden="true">
                <i class="portrait-fragment">?</i>
                <blockquote>Words worth keeping close.</blockquote>
                <i class="reference-fragment"></i>
              </div>
              <span class="coming-soon">Coming soon</span>
            </section>

          </div>
          </div>
        </div>
        </div>
      </section>
    </div>

    <script>
      const stage = document.querySelector<HTMLElement>("[data-transition-stage]");
      const viewport = document.querySelector<HTMLElement>("[data-card-viewport]");
      const heroCard = document.querySelector<HTMLElement>("[data-hero-card]");
      const aboutCard = document.querySelector<HTMLElement>("[data-about-card]");
      const caveCard = document.querySelector<HTMLElement>("[data-cave-card]");
      const cardLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-card-link]")];
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const queuedImageCards = new WeakSet<HTMLElement>();
      let previousActiveIndex = -1;

      const queueCardImages = (card: HTMLElement | null, highPriorityCount = 0) => {
        if (!card || queuedImageCards.has(card)) return;
        queuedImageCards.add(card);
        const images = [...card.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')]
          .filter((image) => !image.complete);

        images.forEach((image, index) => {
          const requestImage = () => {
            image.loading = "eager";
            if (index < highPriorityCount) image.fetchPriority = "high";
          };
          const batch = Math.max(Math.floor((index - highPriorityCount) / 3), 0);
          if (index < highPriorityCount) requestImage();
          else window.setTimeout(requestImage, batch * 180);
        });
      };

      if ("scrollRestoration" in history) history.scrollRestoration = "manual";

      const resetInitialPosition = () => {
        if (!stage || !viewport) return;
        if (location.hash === "#work" || location.hash === "#about" || location.hash === "#cave") {
          history.replaceState(null, "", `${location.pathname}${location.search}`);
        }
        viewport.scrollTop = 0;
        scrollTo({ top: stage.offsetTop, behavior: "auto" });
        updateCards();
      };

      const updateCards = () => {
        if (!stage || !viewport || !heroCard || !aboutCard || !caveCard) return;

        const travel = Math.max(stage.offsetHeight - window.innerHeight, 1);
        const progress = Math.min(Math.max(-stage.getBoundingClientRect().top / travel, 0), 1);
        const activeIndex = progress >= 0.76 ? 2 : progress >= 0.28 ? 1 : 0;
        if (progress >= 0.4) queueCardImages(caveCard, 2);
        if (activeIndex !== previousActiveIndex) {
          previousActiveIndex = activeIndex;
          dispatchEvent(new CustomEvent("portfolio-card-change", { detail: { activeIndex } }));
        }
        cardLinks.forEach((link, index) => {
          if (index === activeIndex) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });

        if (reducedMotion.matches) {
          const showAbout = progress >= 0.25;
          const showCave = progress >= 0.75;
          heroCard.style.opacity = showAbout ? "0" : "1";
          aboutCard.style.opacity = showCave ? "0" : "1";
          aboutCard.style.transform = showAbout ? "translateY(0)" : "translateY(110%)";
          caveCard.style.transform = showCave ? "translateY(0)" : "translateY(110%)";
          return;
        }

        const aboutRise = Math.min(progress * 2, 1);
        const caveRise = Math.min(Math.max(progress * 2 - 1, 0), 1);
        const easedAboutRise = 1 - Math.pow(1 - aboutRise, 3);
        const easedCaveRise = 1 - Math.pow(1 - caveRise, 3);
        const heroFade = Math.min(Math.max((aboutRise - 0.78) / 0.18, 0), 1);
        const aboutFade = Math.min(Math.max((caveRise - 0.78) / 0.18, 0), 1);

        heroCard.style.transform = `translateY(${-36 * aboutRise}px) scale(${1 - 0.09 * aboutRise})`;
        heroCard.style.opacity = String(1 - heroFade);
        aboutCard.style.transform = `translateY(${(1 - easedAboutRise) * 108}%) translateY(${-18 * caveRise}px) scale(${1 - 0.07 * caveRise})`;
        aboutCard.style.opacity = String(1 - aboutFade);
        caveCard.style.transform = `translateY(${(1 - easedCaveRise) * 108}%)`;
      };

      let ticking = false;
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateCards();
          ticking = false;
        });
      };

      updateCards();
      requestAnimationFrame(resetInitialPosition);
      addEventListener("load", () => {
        resetInitialPosition();
        setTimeout(resetInitialPosition, 0);
        window.setTimeout(() => queueCardImages(aboutCard, 2), 200);
      }, { once: true });
      addEventListener("pageshow", resetInitialPosition);
      addEventListener("scroll", requestUpdate, { passive: true });
      addEventListener("resize", requestUpdate);
      reducedMotion.addEventListener("change", requestUpdate);

      cardLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          if (!stage) return;
          event.preventDefault();
          const progress = Number(link.dataset.cardLink ?? 0);
          if (progress >= 0.5) queueCardImages(caveCard, 2);
          else if (progress > 0) queueCardImages(aboutCard, 2);
          const travel = Math.max(stage.offsetHeight - window.innerHeight, 0);
          scrollTo({
            top: stage.offsetTop + travel * progress,
            behavior: reducedMotion.matches ? "auto" : "smooth",
          });
        });
      });

      const githubGrid = document.querySelector<HTMLElement>("[data-github-grid]");
      const githubTotal = document.querySelector<HTMLElement>("[data-github-total]");

      if (githubGrid && githubTotal) {
        fetch("https://github-contributions-api.jogruber.de/v4/ilyastorunn?y=last")
          .then((response) => {
            if (!response.ok) throw new Error("GitHub activity unavailable");
            return response.json();
          })
          .then((payload) => {
            const contributions = Array.isArray(payload.contributions)
              ? payload.contributions.slice(-112)
              : [];
            const cells = [...githubGrid.querySelectorAll<HTMLElement>("i")];
            contributions.forEach((day: { count?: number; date?: string; level?: number }, index: number) => {
              const cell = cells[index];
              if (!cell) return;
              cell.dataset.level = String(Math.min(Number(day.level ?? 0), 4));
              cell.title = `${day.count ?? 0} contributions on ${day.date ?? "this day"}`;
            });
            const total = Object.values(payload.total ?? {}).reduce(
              (sum: number, value) => sum + Number(value ?? 0),
              0,
            );
            githubTotal.textContent = `${total.toLocaleString()} this year`;
          })
          .catch(() => {
            githubTotal.textContent = "Public profile";
          });
      }

      const musicCard = document.querySelector<HTMLElement>("[data-music-card]");
      const musicToggle = document.querySelector<HTMLButtonElement>("[data-music-toggle]");
      const musicAudio = document.querySelector<HTMLAudioElement>("[data-music-audio]");

      if (musicCard && musicToggle && musicAudio) {
        musicAudio.volume = 0.5;

        const setMusicState = (playing: boolean) => {
          musicCard.classList.toggle("is-playing", playing);
          musicToggle.textContent = playing ? "Ⅱ" : "▶";
          musicToggle.setAttribute("aria-pressed", String(playing));
          musicToggle.setAttribute("aria-label", playing ? "Pause All Caps preview" : "Play All Caps preview");
        };

        musicToggle.addEventListener("click", async () => {
          if (musicAudio.paused) {
            try {
              await musicAudio.play();
              setMusicState(true);
            } catch {
              setMusicState(false);
            }
          } else {
            musicAudio.pause();
            setMusicState(false);
          }
        });

        musicAudio.addEventListener("ended", () => setMusicState(false));
        musicAudio.addEventListener("pause", () => setMusicState(false));
      }

      const caveBoard = document.querySelector<HTMLElement>("[data-cave-board]");
      const dragItems = [...document.querySelectorAll<HTMLElement>("[data-drag-item]")];
      const bookButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-book-button]")];
      const photosCluster = document.querySelector<HTMLElement>(".photos-cluster");
      const photoOpenButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-photo-open]")];
      const photoCollapseButton = document.querySelector<HTMLButtonElement>("[data-photo-collapse]");

      const closePhotoSheet = () => {
        photosCluster?.classList.remove("is-expanded");
        photosCluster?.setAttribute("aria-label", "Photograph stamp sheet. Drag to move or select a photograph to enlarge.");
      };

      photoOpenButtons.forEach((button) => {
        button.addEventListener("pointerdown", (event) => event.stopPropagation());
        button.addEventListener("keydown", (event) => event.stopPropagation());
        button.addEventListener("click", () => {
          if (!photosCluster?.classList.contains("is-expanded")) {
            photosCluster?.classList.add("is-expanded");
            photosCluster?.setAttribute("aria-label", "Enlarged photograph stamp sheet. Select a photograph to read its note.");
          }
        });
      });

      photoCollapseButton?.addEventListener("pointerdown", (event) => event.stopPropagation());
      photoCollapseButton?.addEventListener("click", closePhotoSheet);
      addEventListener("keydown", (event) => {
        if (event.key === "Escape" && photosCluster?.classList.contains("is-expanded")) {
          closePhotoSheet();
          photoOpenButtons[0]?.focus();
        }
      });

      bookButtons.forEach((button) => {
        const ensureBookPreview = () => {
          const existingPreview = button.querySelector<HTMLElement>(".book-preview");
          if (existingPreview) return existingPreview;
          const template = button.querySelector<HTMLTemplateElement>("[data-book-preview-template]");
          if (!template) return null;

          button.append(template.content.cloneNode(true));
          template.remove();
          const preview = button.querySelector<HTMLElement>(".book-preview");
          const model = preview?.querySelector<HTMLElement>(".book-model");

          preview?.addEventListener("pointermove", (event) => {
            if (!model || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            const bounds = preview.getBoundingClientRect();
            const x = Math.min(Math.max((event.clientX - bounds.left) / bounds.width, 0), 1);
            const y = Math.min(Math.max((event.clientY - bounds.top) / bounds.height, 0), 1);
            model.style.setProperty("--book-rotate-y", `${-14 + (x - 0.5) * 18}deg`);
            model.style.setProperty("--book-rotate-x", `${(y - 0.5) * -8}deg`);
          });

          preview?.addEventListener("pointerleave", () => {
            model?.style.removeProperty("--book-rotate-y");
            model?.style.removeProperty("--book-rotate-x");
          });

          return preview ?? null;
        };

        button.addEventListener("pointerdown", (event) => event.stopPropagation());
        button.addEventListener("keydown", (event) => event.stopPropagation());
        button.addEventListener("pointerenter", ensureBookPreview, { once: true });
        button.addEventListener("focus", ensureBookPreview, { once: true });
        button.addEventListener("click", () => {
          ensureBookPreview();
          const willOpen = !button.classList.contains("is-open");
          bookButtons.forEach((candidate) => {
            candidate.classList.remove("is-open");
            candidate.setAttribute("aria-pressed", "false");
          });
          if (willOpen) {
            button.classList.add("is-open");
            button.setAttribute("aria-pressed", "true");
          }
        });
      });

      const filmsCluster = document.querySelector<HTMLElement>(".films-cluster");
      const filmPreview = document.querySelector<HTMLElement>("[data-film-hover-preview]");
      const filmPreviewImage = filmPreview?.querySelector<HTMLImageElement>("[data-film-preview-image]");
      const filmStars = [...(filmPreview?.querySelectorAll<HTMLElement>(".film-stars i") ?? [])];
      const filmFrames = [...document.querySelectorAll<HTMLElement>("[data-film-frame]")];

      filmFrames.forEach((frame) => {
        frame.addEventListener("pointerenter", () => {
          if (!filmsCluster || !filmPreview || !filmPreviewImage) return;
          const sourceImage = frame.querySelector<HTMLImageElement>("img");
          const rating = Number.parseFloat(frame.dataset.filmRating ?? "0");
          const frameBounds = frame.getBoundingClientRect();
          const clusterBounds = filmsCluster.getBoundingClientRect();
          const center = frameBounds.left + frameBounds.width / 2 - clusterBounds.left;
          const safeCenter = Math.min(Math.max(center, clusterBounds.width * 0.17), clusterBounds.width * 0.83);

          filmPreviewImage.src = sourceImage?.currentSrc || sourceImage?.src || "";
          filmPreview.style.left = `${safeCenter}px`;
          filmPreview.setAttribute("data-visible", "true");
          filmStars.forEach((star, index) => {
            const fill = Math.min(Math.max(rating - index, 0), 1) * 100;
            star.style.setProperty("--star-fill", `${fill}%`);
          });
        });

        frame.addEventListener("pointerleave", () => {
          filmPreview?.removeAttribute("data-visible");
        });
      });

      if (caveBoard) {
        let topLayer = 10;
        const keepItemsInsideBoard = () => {
          dragItems.forEach((item) => {
            if (!item.style.left && !item.style.top) return;
            const maxX = Math.max(caveBoard.clientWidth - item.offsetWidth, 0);
            const maxY = Math.max(caveBoard.clientHeight - item.offsetHeight, 0);
            item.style.left = `${Math.min(Math.max(Number.parseFloat(item.style.left) || 0, 0), maxX)}px`;
            item.style.top = `${Math.min(Math.max(Number.parseFloat(item.style.top) || 0, 0), maxY)}px`;
          });
        };

        dragItems.forEach((item) => {
          item.addEventListener("pointerdown", (event) => {
            if (event.button !== 0 || (event.target as Element).closest("[data-no-drag]")) return;
            const boardBounds = caveBoard.getBoundingClientRect();
            const itemBounds = item.getBoundingClientRect();
            const startX = event.clientX;
            const startY = event.clientY;
            const originX = itemBounds.left - boardBounds.left;
            const originY = itemBounds.top - boardBounds.top;
            const maxX = Math.max(boardBounds.width - itemBounds.width, 0);
            const maxY = Math.max(boardBounds.height - itemBounds.height, 0);
            item.setPointerCapture(event.pointerId);
            item.classList.add("is-dragging");
            item.style.zIndex = String(++topLayer);

            const move = (moveEvent: PointerEvent) => {
              const x = Math.min(Math.max(originX + moveEvent.clientX - startX, 0), maxX);
              const y = Math.min(Math.max(originY + moveEvent.clientY - startY, 0), maxY);
              item.style.left = `${x}px`;
              item.style.top = `${y}px`;
              item.style.right = "auto";
              item.style.bottom = "auto";
            };

            const finish = () => {
              item.classList.remove("is-dragging");
              item.removeEventListener("pointermove", move);
              item.removeEventListener("pointerup", finish);
              item.removeEventListener("pointercancel", finish);
            };

            item.addEventListener("pointermove", move);
            item.addEventListener("pointerup", finish);
            item.addEventListener("pointercancel", finish);
          });

          item.addEventListener("keydown", (event) => {
            const movement = { ArrowLeft: [-10, 0], ArrowRight: [10, 0], ArrowUp: [0, -10], ArrowDown: [0, 10] }[event.key];
            if (!movement) return;
            event.preventDefault();
            const boardBounds = caveBoard.getBoundingClientRect();
            const itemBounds = item.getBoundingClientRect();
            const currentX = itemBounds.left - boardBounds.left;
            const currentY = itemBounds.top - boardBounds.top;
            const maxX = Math.max(caveBoard.clientWidth - item.offsetWidth, 0);
            const maxY = Math.max(caveBoard.clientHeight - item.offsetHeight, 0);
            item.style.left = `${Math.min(Math.max(currentX + movement[0], 0), maxX)}px`;
            item.style.top = `${Math.min(Math.max(currentY + movement[1], 0), maxY)}px`;
            item.style.right = "auto";
            item.style.bottom = "auto";
            item.style.zIndex = String(++topLayer);
          });
        });
        addEventListener("resize", keepItemsInsideBoard);
      }
    </script>
  </body>
</html>

