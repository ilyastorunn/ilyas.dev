  .board-cluster h3 { position: absolute; margin: 0; padding: 0.28rem 0.45rem 0.24rem; border: 2px solid #272230; background: #fffaf0; font-family: "Arial Black", sans-serif; font-size: clamp(0.54rem, 0.78vw, 0.76rem); line-height: 1; text-transform: uppercase; }

