  .book-preview { position: absolute; z-index: 20; bottom: -18%; left: calc(100% + 0.18rem); display: grid; visibility: hidden; width: clamp(7rem, 10vw, 9.5rem); aspect-ratio: 0.72; opacity: 0; perspective: 42rem; pointer-events: none; place-items: end center; transform: translateX(-0.55rem) scale(0.72); transform-origin: bottom left; transition: visibility 0s linear 180ms, opacity 180ms ease, transform 260ms cubic-bezier(.2,.8,.2,1); }
  .book-preview::before { position: absolute; top: 0; right: 100%; bottom: 0; width: 0.5rem; content: ""; }
  .real-book:is(:hover, :focus-visible, .is-open) .book-preview { visibility: visible; opacity: 1; pointer-events: auto; transform: translateX(0) scale(var(--preview-scale)); transition-delay: 0s; }
  .book-preview > strong { position: absolute; right: -12%; bottom: -10%; left: -12%; padding: 0.3rem 0.4rem; border: 2px solid #272230; background: #fffaf0; box-shadow: 0.22rem 0.22rem 0 #d23440; color: #272230; font: 700 clamp(0.42rem, 0.58vw, 0.58rem)/1.05 "Arial Black", sans-serif; text-align: center; text-transform: uppercase; transform: rotate(-2deg); }
  .book-model { --book-rotate-x:2deg; --book-rotate-y:-28deg; position: absolute; top: 0; left: 50%; width: 78%; height: 88%; transform: translateX(-50%) rotateX(var(--book-rotate-x)) rotateY(var(--book-rotate-y)); transform-style: preserve-3d; transition: transform 520ms cubic-bezier(.2,.8,.2,1); will-change: transform; }
  .real-book:is(:hover, :focus-visible, .is-open) .book-model { --book-rotate-x:1deg; --book-rotate-y:-14deg; }
  .book-face, .book-pages { position: absolute; display: block; overflow: hidden; border: 1px solid rgb(26 20 17 / 52%); backface-visibility: hidden; }
