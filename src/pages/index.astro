---
import "@fontsource/caveat/500.css";
import "@fontsource/caveat/700.css";
import { ROOMS } from "../lib/unfold/rooms";
import { SPOTS } from "../lib/unfold/spots";

const title = "İlyas Torun — Independent Developer";
const description = "İlyas Torun is an independent developer building thoughtful products for the web and iOS.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ecebe7" />
    <title>{title}</title>
    <!-- With JavaScript, go straight to the book's loading state instead of flashing the
         plain-HTML version; the script removes this again if WebGL is unavailable. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <main class="stage" data-book>
      <header class="topbar">
        <div class="wordmark">
          ily.dev
          <svg class="underline" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 9 C 30 5, 70 11, 118 6"></path>
            <path d="M8 12 C 40 9, 80 13, 112 10" opacity="0.5"></path>
          </svg>
        </div>
      </header>

      <!-- Readable content: the page itself without JavaScript or WebGL, and a screen-reader
           companion to the book once it has loaded. -->
      <section class="fallback" aria-labelledby="fallback-title">
        <h1 id="fallback-title">İlyas Torun</h1>
        <p>{description}</p>
        {
          ROOMS.map((room) => (
            <section>
              <h2>{room.name}</h2>
              {Object.values(SPOTS[room.id] ?? {}).map((spot) => (
                <article>
                  <h3>{spot.title}</h3>
                  {spot.tagline && <p><strong>{spot.tagline}</strong></p>}
                  <p>{spot.body}</p>
                  {spot.links && (
                    <ul>
                      {spot.links.map((l) => (
                        <li>
                          <a href={l.href}>{l.label}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </section>
          ))
        }
      </section>

      <div class="canvas-wrap" data-book-canvas>
        <div class="loading" aria-hidden="true">sharpening pencils…</div>
      </div>

      <button class="arrow arrow-left" type="button" aria-label="Close the book" data-book-prev disabled>
        <svg viewBox="0 0 90 64" width="78" height="56" style="transform: scaleX(-1)" aria-hidden="true">
          <path d="M8 34 C 24 30.5, 44 36.5, 77 31.5"></path>
          <path d="M57 14.5 C 64 21, 71 27, 79 31.8 C 71 36.5, 64 42.5, 56.5 50"></path>
          <path d="M10 37.5 C 30 35, 50 39, 70 35.5" opacity="0.35"></path>
        </svg>
      </button>
      <button class="arrow arrow-right" type="button" aria-label="Open the book" data-book-next>
        <svg viewBox="0 0 90 64" width="78" height="56" aria-hidden="true">
          <path d="M8 34 C 24 30.5, 44 36.5, 77 31.5"></path>
          <path d="M57 14.5 C 64 21, 71 27, 79 31.8 C 71 36.5, 64 42.5, 56.5 50"></path>
          <path d="M10 37.5 C 30 35, 50 39, 70 35.5" opacity="0.35"></path>
        </svg>
      </button>

      <footer class="caption" data-book-caption>
        <div class="room-name" data-caption-name>İlyas Torun</div>
        <div class="room-mood" data-caption-mood>tap the cover to open</div>
        <ul class="spot-list" aria-label="In this room" data-book-spots hidden></ul>
      </footer>
      <p class="sr-only" aria-live="polite" data-book-live></p>
      <div class="spot-tip" aria-hidden="true" data-book-tip hidden></div>

      <dialog class="note" data-book-note aria-labelledby="note-title" tabindex="-1">
        <div class="note-top">
          <p class="note-kicker" data-note-kicker hidden></p>
          <span class="note-count" data-note-count aria-hidden="true"></span>
          <form method="dialog">
            <button class="note-close" aria-label="Close">×</button>
          </form>
        </div>
        <h2 id="note-title" data-note-title></h2>
        <p class="note-tagline" data-note-tagline hidden></p>
        <p class="note-body" data-note-body></p>
        <ul class="note-facts" aria-label="Highlights" data-note-facts hidden></ul>
        <ul class="note-links" data-note-links></ul>
      </dialog>
    </main>

    <script>
      import "../scripts/book/index";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #2b1fd6;
    --ink-soft: rgba(43, 31, 214, 0.55);
    --paper: #ecebe7;
    --hand: "Caveat", cursive;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    color: var(--ink);
    font-family: var(--hand);
    background-color: var(--paper);
    /* paper grain + a soft vignette */
    background-image:
      radial-gradient(ellipse at 50% 45%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 60%),
      radial-gradient(ellipse at 50% 50%, rgba(0, 0, 0, 0) 55%, rgba(60, 50, 30, 0.09) 100%),
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='260'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.35  0 0 0 0 0.3  0 0 0 0 0.22  0 0 0 0.09 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-attachment: fixed;
    -webkit-font-smoothing: antialiased;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  :focus-visible {
    outline: 2px dashed var(--ink);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* ---- without JS / WebGL: a plain readable page -------------------------- */

  .stage .canvas-wrap,
  .stage .arrow,
  .stage .caption {
    display: none;
  }

  .fallback {
    max-width: 38rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .fallback h1 {
    font-size: 3rem;
    margin: 0 0 0.5rem;
  }

  .fallback h2 {
    font-size: 2.2rem;
    margin: 2rem 0 0.25rem;
  }

  .fallback a,
  .note a {
    color: inherit;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 28px 0;
    z-index: 2;
  }

  .wordmark {
    position: relative;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
  }

  .wordmark .underline {
    position: absolute;
    left: -4px;
    bottom: -10px;
    width: calc(100% + 8px);
    height: 12px;
  }

  .underline path,
  .arrow path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- the book, once the script has started it -------------------------- */

  .js .stage {
    position: fixed;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    user-select: none;
    overflow: hidden;
  }

  .js .stage .fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* the canvas is full-bleed; header and caption float over it (the scene frames the book
     between them, so close-ups are no longer cut off at those rows) */
  .js .stage .canvas-wrap {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: grab;
    touch-action: none;
  }

  .js .stage .topbar {
    position: relative;
    pointer-events: none;
  }

  .js .stage .topbar > * {
    pointer-events: auto;
  }

  .js .stage .canvas-wrap:active {
    cursor: grabbing;
  }

  .canvas-wrap canvas {
    position: absolute;
    inset: 0;
    display: block;
  }

  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 28px;
    opacity: 0.6;
  }

  .canvas-wrap:has(canvas) .loading {
    display: none;
  }

  .stage.is-ready .arrow {
    display: block;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: 0;
    padding: 18px;
    cursor: pointer;
    z-index: 3;
    transition:
      opacity 0.3s ease,
      transform 0.2s ease;
  }

  .arrow-left {
    left: max(12px, 4vw);
  }

  .arrow-right {
    right: max(12px, 4vw);
  }

  .arrow:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.08) rotate(-3deg);
  }

  .arrow:disabled {
    opacity: 0.18;
    cursor: default;
  }

  .stage.is-ready .caption {
    display: block;
    position: relative;
    grid-row: 3;
    text-align: center;
    padding: 0 24px 26px;
    min-height: 92px;
    z-index: 2;
    pointer-events: none;
  }

  .stage.is-ready .caption .spot-list {
    pointer-events: auto;
  }

  .spot-list button[aria-current="true"] {
    border-bottom: 2.5px solid var(--ink);
  }

  .room-name {
    font-size: 46px;
    font-weight: 700;
    line-height: 1;
  }

  .room-mood {
    font-size: 22px;
    opacity: 0.7;
    margin-top: 6px;
  }

  .spot-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .spot-list[hidden] {
    display: none;
  }

  .spot-list button {
    font: 600 22px var(--hand);
    color: var(--ink);
    background: none;
    border: 0;
    border-bottom: 1.5px solid var(--ink-soft);
    padding: 0 2px;
    cursor: pointer;
  }

  .spot-list button:hover {
    border-bottom-color: var(--ink);
  }

  .spot-tip {
    position: fixed;
    z-index: 4;
    transform: translate(14px, -130%);
    padding: 2px 10px;
    font: 700 22px var(--hand);
    color: var(--ink);
    background: #fbfaf5;
    border: 1.5px solid var(--ink);
    border-radius: 8px 10px 7px 9px;
    pointer-events: none;
    white-space: nowrap;
  }

  .spot-tip[hidden] {
    display: none;
  }

  /* ---- close-up note: a paper card taped beside the zoomed object ---------- */

  .note {
    --tilt: -1.2deg;
    position: fixed;
    inset: auto;
    top: 50%;
    right: calc(max(12px, 4vw) + 100px); /* clear of the right arrow */
    z-index: 3;
    width: min(24rem, 33vw);
    max-height: calc(100svh - 200px);
    margin: 0;
    padding: 1.6rem 1.75rem 1.5rem;
    overflow: auto;
    color: var(--ink);
    font-family: var(--hand);
    font-size: 1.4rem;
    line-height: 1.28;
    background:
      repeating-linear-gradient(transparent 0 33px, rgba(43, 31, 214, 0.07) 33px 34px),
      #fffdf6;
    background-position: 0 14px;
    border: 2px solid var(--ink);
    border-radius: 12px 6px 14px 8px / 8px 14px 6px 12px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 22px 44px -18px rgba(42, 35, 80, 0.35);
    transform: translateY(-50%) rotate(var(--tilt));
  }

  /* the note itself only receives focus so screen readers announce it; its controls keep
     their own visible focus */
  .note:focus,
  .note:focus-visible {
    outline: none;
  }

  /* while a note is open, only the project buttons stay in the caption */
  .room-name,
  .room-mood {
    transition: opacity 0.25s ease;
  }

  .is-closeup .room-name,
  .is-closeup .room-mood {
    opacity: 0;
  }

  /* a strip of tape holding the note */
  .note::before {
    content: "";
    position: absolute;
    top: -12px;
    left: 50%;
    width: 92px;
    height: 24px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(43, 31, 214, 0.18);
    transform: translateX(-50%) rotate(3deg);
  }

  .note-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 1.6rem;
  }

  .note-kicker {
    margin: 0;
    padding: 0 0.55rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    border: 1.5px solid var(--ink-soft);
    border-radius: 999px;
  }

  .note-count {
    margin-left: auto;
    font-size: 1.1rem;
    opacity: 0.6;
  }

  .note-top form {
    margin: 0;
  }

  .note-close {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin: -0.4rem -0.6rem -0.4rem 0;
    font: 700 1.9rem/1 var(--hand);
    color: var(--ink);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .note-close:hover {
    background: rgba(43, 31, 214, 0.08);
  }

  .note h2 {
    margin: 0.7rem 0 0;
    font-size: 2.6rem;
    line-height: 0.95;
  }

  .note-tagline {
    position: relative;
    display: inline-block;
    margin: 0.45rem 0 0;
    font-size: 1.55rem;
    font-weight: 700;
  }

  /* hand-drawn highlighter under the tagline */
  .note-tagline::after {
    content: "";
    position: absolute;
    left: -4px;
    right: -6px;
    bottom: 2px;
    height: 0.5em;
    z-index: -1;
    background: rgba(255, 226, 120, 0.7);
    border-radius: 3px 8px 4px 9px;
    transform: rotate(-0.8deg);
  }

  .note-body {
    margin: 0.75rem 0 0;
  }

  .note-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1.1rem;
  }

  .note-facts li {
    padding: 0.05rem 0.6rem;
    background: rgba(43, 31, 214, 0.06);
    border: 1.5px dashed var(--ink-soft);
    border-radius: 8px;
  }

  .note-links {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .note-links a {
    display: inline-block;
    font-size: 1.45rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .note-kicker[hidden],
  .note-tagline[hidden],
  .note-facts[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .note.is-in {
      animation: note-in 0.42s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }

  @keyframes note-in {
    from {
      opacity: 0;
      transform: translateY(calc(-50% + 14px)) rotate(calc(var(--tilt) + 2.5deg));
    }
  }

  @media (max-width: 640px) {
    .topbar {
      padding: 14px 16px 0;
    }
    .wordmark {
      font-size: 32px;
    }
    .stage.is-ready .caption {
      padding: 0 84px 24px;
    }
    .room-name {
      font-size: 40px;
    }
    .room-mood {
      font-size: 19px;
    }
    .arrow-left {
      left: 0;
    }
    .arrow-right {
      right: 0;
    }
    /* on phones the note is a sheet along the bottom; the object is lifted above it */
    .note {
      --tilt: -0.6deg;
      top: auto;
      right: 12px;
      bottom: 12px;
      left: 12px;
      width: auto;
      max-height: 48svh;
      padding: 1.25rem 1.25rem 1.1rem;
      font-size: 1.25rem;
      transform: rotate(var(--tilt));
    }
    .note h2 {
      font-size: 2.2rem;
    }
    @keyframes note-in {
      from {
        opacity: 0;
        transform: translateY(18px) rotate(var(--tilt));
      }
    }
    /* while it is open, the arrows sit just above the sheet */
    .stage.is-closeup .arrow {
      top: calc(52svh - 60px);
    }
  }
</style>
