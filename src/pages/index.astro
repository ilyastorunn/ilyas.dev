---
import { Image } from "astro:assets";
import "@fontsource-variable/instrument-sans";
import spiderManComic from "../assets/spider-man-artgerm.webp";
import cyclopsComic from "../assets/cyclops-comic.png";
import cerebroScanner from "../assets/cerebro-scanner-original.png";
import madvillainyCover from "../assets/madvillainy-cover.png";
import doctorDoomComic from "../assets/doctor-doom-comic.png";
import galactusStation from "../assets/galactus-space-station-ff49.webp";
import reedRichardsWork from "../assets/reed-richards-work.jpg";
import unscrollIcon from "../assets/unscroll-icon.jpg";
import mementoIcon from "../assets/memento-icon.jpg";

const title = "İlyas Torun — Independent Developer";
const email = "ilyastorun.dev@gmail.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="İlyas Torun is an independent developer designing and building thoughtful products for the web and Apple platforms."
    />
    <meta name="theme-color" content="#f1f2f3" />
    <title>{title}</title>
  </head>
  <body>
    <div class="card-stack">
      <section class="transition-stage" data-transition-stage>
        <div class="card-viewport" data-card-viewport>
        <div class="site-canvas stack-card hero-card" data-hero-card>
        <header class="site-header">
          <nav class="section-preview" aria-label="Portfolio sections">
            <a href="#work" data-card-link="0" aria-current="page">Home</a>
            <a href="#about" data-card-link="0.5">About me</a>
            <a href="#cave" data-card-link="1">Cave</a>
          </nav>

          <a class="contact" href={`mailto:${email}`}>
            <span>Contact me</span>
            <span aria-hidden="true">↗</span>
          </a>
        </header>

        <main>
          <section class="hero" aria-labelledby="intro-title">
            <h1 id="intro-title" class="sr-only">
              Independent developer designing and building thoughtful products for the web and Apple platforms.
            </h1>

            <figure class="hero-visual">
              <Image
                src={spiderManComic}
                alt="Spider-Man reaches toward the viewer between New York skyscrapers."
                widths={[480, 720, 960, 1200, 1600, 2400]}
                sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1520px) calc(100vw - 180px), 1270px"
                loading="eager"
                fetchpriority="high"
              />

              <div class="hero-dialogue" aria-label="Welcome message from İlyas">
                <p class="speech-bubble speech-one">Hey, I’m İlyas.</p>
                <p class="speech-bubble speech-two">I build thoughtful products for web &amp; iOS.</p>
                <p class="speech-bubble speech-three">Welcome to my little corner of the internet.</p>
              </div>
            </figure>

            <div class="scroll-cue" aria-hidden="true">
              <span>swipe down, please :)</span>
              <svg viewBox="0 0 46 56" role="img">
                <path d="M20 3c2 14 3 25 1 39" />
                <path d="m9 33 12 11 14-10" />
              </svg>
            </div>
          </section>
        </main>
        </div>
        <div class="site-canvas stack-card about-card" data-about-card aria-labelledby="about-title">
          <div class="about-heading">
            <p class="about-kicker">The person behind the pixels</p>
            <div class="about-title-lockup">
              <h2 id="about-title">About!</h2>
              <span aria-hidden="true">issue no. 01</span>
            </div>
            <p class="about-doodle" aria-hidden="true">meet the human →</p>
          </div>

          <div class="about-bento">
            <article class="bento-panel story-panel">
              <Image
                class="cyclops-backdrop"
                src={cyclopsComic}
                alt=""
                widths={[480, 720, 960]}
                sizes="(max-width: 768px) calc(100vw - 40px), 40vw"
                aria-hidden="true"
              />
              <div class="story-caption story-origin">
                <span>Origin story</span>
                <p>It started with a C++ class in 2018.</p>
              </div>
              <div class="story-caption story-intro">
                <p>Hey, I’m Ilyas — an independent developer building thoughtful products for the web and iOS.</p>
              </div>
              <div class="story-caption story-now">
                <span>Meanwhile, today…</span>
                <p>I craft digital products, build my own ideas, and keep pushing what I can make.</p>
              </div>
            </article>

            <article class="bento-panel github-panel" data-github-card>
              <Image
                class="cerebro-backdrop"
                src={cerebroScanner}
                alt=""
                widths={[720, 1200, 1800]}
                sizes="(max-width: 768px) calc(100vw - 40px), 32vw"
                aria-hidden="true"
              />
              <div class="github-head">
                <a class="github-title-card" href="https://github.com/ilyastorunn" target="_blank" rel="noreferrer">
                  ilyastorunn’s GitHub Activity! <span aria-hidden="true">↗</span>
                </a>
                <span class="github-total" data-github-total>Loading…</span>
              </div>
              <div class="activity-scanner">
                <div class="contribution-grid" data-github-grid aria-label="Recent GitHub contributions">
                  {Array.from({ length: 112 }, (_, index) => <i style={`--delay:${index}`} aria-hidden="true"></i>)}
                </div>
              </div>
            </article>

            <article class="bento-panel music-panel" data-music-card>
              <Image
                class="doom-backdrop"
                src={doctorDoomComic}
                alt="Doctor Doom raising his fists beneath the words This land is mine."
                widths={[400, 800]}
                sizes="(max-width: 768px) 50vw, 25vw"
              />
              <div class="record" aria-hidden="true">
                <span class="record-label"><Image src={madvillainyCover} alt="" widths={[160, 300]} /></span>
                <span class="record-hole"></span>
              </div>
              <div class="music-copy">
                <p class="panel-value">All Caps</p>
                <p class="track-artist">MF DOOM</p>
              </div>
              <button class="play-button" type="button" data-music-toggle aria-label="Play All Caps preview" aria-pressed="false">▶</button>
              <audio data-music-audio preload="auto" src="https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview112/v4/21/bc/bc/21bcbc11-adf7-1c11-ec7f-ca60bb54921d/mzaf_12993966015311248438.plus.aac.p.m4a"></audio>
            </article>

            <article class="bento-panel apps-panel">
              <Image
                class="app-comic-backdrop"
                src={galactusStation}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(max-width: 768px) 50vw, 25vw"
                aria-hidden="true"
              />
              <div class="apps-copy">
                <p class="panel-label">Three apps, one pocket</p>
                <p class="panel-value">Things I’ve made.</p>
              </div>
              <div class="app-launchers" aria-label="Apps by İlyas Torun">
                <a class="app-launcher app-launcher-one" href="https://apps.apple.com/tr/app/unscroll-ekran-s%C3%BCresi/id6766120727?l=tr" target="_blank" rel="noreferrer" aria-label="Open Unscroll on the App Store">
                  <span class="app-icon"><Image src={unscrollIcon} alt="" widths={[120]} /></span>
                  <span class="app-info"><b>Unscroll</b><small>Screen time, reclaimed. ↗</small></span>
                </a>
                <a class="app-launcher app-launcher-two" href="https://apps.apple.com/tr/app/memento-takvim/id6757344347?l=tr" target="_blank" rel="noreferrer" aria-label="Open Memento on the App Store">
                  <span class="app-icon"><Image src={mementoIcon} alt="" widths={[120]} /></span>
                  <span class="app-info"><b>Memento</b><small>Your calendar, remembered. ↗</small></span>
                </a>
                <span class="app-launcher app-launcher-three" tabindex="0" aria-label="Next app, currently in review">
                  <span class="app-icon"><i>?</i></span>
                  <span class="app-info"><b>Next app</b><small>Currently in review.</small></span>
                </span>
              </div>
            </article>

            <article class="bento-panel websites-panel">
              <Image
                class="workshop-backdrop"
                src={reedRichardsWork}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(max-width: 768px) calc(100vw - 40px), 34vw"
                aria-hidden="true"
              />
              <div class="website-headline">
                <p>What I’m building nowadays!</p>
              </div>
              <div class="live-preview" tabindex="0">
                <iframe src="https://screen-studio.pages.dev/" title="Live preview of Screen Studio" loading="lazy"></iframe>
                <span class="preview-screen" aria-hidden="true">
                  <b>Screen Studio</b>
                  <small>Hover for the live report →</small>
                </span>
                <span class="preview-scroll-hint" aria-hidden="true">scroll ↓</span>
              </div>
            </article>
          </div>
        </div>
        <div class="site-canvas stack-card cave-card" data-cave-card aria-labelledby="cave-title">
          <header class="cave-heading">
            <p>Personal archive / slowly collecting</p>
            <h2 id="cave-title">Cave</h2>
            <span>Books, photographs, inspiration and recent watches.</span>
          </header>

          <div class="cave-board" data-cave-board aria-label="A movable personal archive board">
            <p class="board-note board-note-books" aria-hidden="true">books I keep close ↘</p>
            <section class="board-cluster books-cluster" data-drag-item tabindex="0" aria-label="Books shelf. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="mini-shelf" aria-hidden="true">
                <div class="shelf-books">
                  <i style="--book:#782d2d;--h:74%;--w:13%;--r:-4deg"><span>BOOK 01</span><small></small></i>
                  <i style="--book:#355f64;--h:91%;--w:15%;--r:-1deg"><span>BOOK 02</span><small></small></i>
                  <i style="--book:#c18a38;--h:67%;--w:11%;--r:2deg"><span>03</span><small></small></i>
                  <i style="--book:#ddd0b3;--h:84%;--w:17%;--r:0deg"><span>BOOK 04</span><small></small></i>
                  <i style="--book:#39333b;--h:77%;--w:12%;--r:5deg"><span>05</span><small></small></i>
                  <i style="--book:#8b5637;--h:87%;--w:14%;--r:1deg"><span>BOOK 06</span><small></small></i>
                </div>
                <b class="shelf-plank"></b>
              </div>
              <h3>Books</h3>
            </section>

            <p class="board-note board-note-films" aria-hidden="true">recently watched ↙</p>
            <section class="board-cluster films-cluster" data-drag-item tabindex="0" aria-label="Recently watched films. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="film-strip" aria-hidden="true">
                <div class="film-strip-track">
                  {[0, 1].map(() => Array.from({ length: 10 }, (_, index) => (
                    <i class="film-frame" style={`--frame:${index}`}>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <small><b>Film title</b><em>— / 10 · one-line note</em></small>
                    </i>
                  )))}
                </div>
              </div>
              <h3>Recently developed</h3>
            </section>

            <p class="board-note board-note-photos" aria-hidden="true">photos I took ↗</p>
            <section class="board-cluster photos-cluster" data-drag-item tabindex="0" aria-label="Photograph stamp sheet. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="stamp-sheet" aria-hidden="true">
                {Array.from({ length: 9 }, (_, index) => (
                  <i class={`photo-stamp stamp-${index + 1}`} style={`--stamp:${index}`}>
                    <span></span>
                    <small><b>{String(index + 1).padStart(2, "0")}</b><em>ILYAS · 2026</em></small>
                  </i>
                ))}
              </div>
              <h3>Photos</h3>
            </section>

            <p class="board-note board-note-tech" aria-hidden="true">things I build with ↖</p>
            <section class="board-cluster tech-cluster" data-drag-item tabindex="0" aria-label="Technology stack. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="tech-stack" aria-hidden="true">
                <i style="--i:0">MacBook</i><i style="--i:1">Xcode</i><i style="--i:2">Swift</i><i style="--i:3">React</i><i style="--i:4">Codex</i>
              </div>
              <h3>Tech stack</h3>
            </section>

            <section class="board-cluster inspiration-cluster" data-drag-item tabindex="0" aria-label="Inspiration fragments. Drag to move.">
              <span class="board-pin" aria-hidden="true"></span>
              <div class="inspiration-fragments" aria-hidden="true">
                <i class="portrait-fragment">?</i>
                <blockquote>Words worth keeping close.</blockquote>
                <i class="reference-fragment"></i>
              </div>
              <h3>Inspiration</h3>
            </section>

            <span class="board-whisper" aria-hidden="true">move things around if you feel like it</span>
          </div>
        </div>
        </div>
      </section>
    </div>

    <script>
      const stage = document.querySelector<HTMLElement>("[data-transition-stage]");
      const viewport = document.querySelector<HTMLElement>("[data-card-viewport]");
      const heroCard = document.querySelector<HTMLElement>("[data-hero-card]");
      const aboutCard = document.querySelector<HTMLElement>("[data-about-card]");
      const caveCard = document.querySelector<HTMLElement>("[data-cave-card]");
      const cardLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-card-link]")];
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let previousActiveIndex = -1;

      if ("scrollRestoration" in history) history.scrollRestoration = "manual";

      const resetInitialPosition = () => {
        if (!stage || !viewport) return;
        if (location.hash === "#work" || location.hash === "#about" || location.hash === "#cave") {
          history.replaceState(null, "", `${location.pathname}${location.search}`);
        }
        viewport.scrollTop = 0;
        scrollTo({ top: stage.offsetTop, behavior: "auto" });
        updateCards();
      };

      const updateCards = () => {
        if (!stage || !viewport || !heroCard || !aboutCard || !caveCard) return;

        const travel = Math.max(stage.offsetHeight - window.innerHeight, 1);
        const progress = Math.min(Math.max(-stage.getBoundingClientRect().top / travel, 0), 1);
        const activeIndex = progress >= 0.76 ? 2 : progress >= 0.28 ? 1 : 0;
        if (activeIndex !== previousActiveIndex) {
          previousActiveIndex = activeIndex;
          dispatchEvent(new CustomEvent("portfolio-card-change", { detail: { activeIndex } }));
        }
        cardLinks.forEach((link, index) => {
          if (index === activeIndex) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });

        if (reducedMotion.matches) {
          const showAbout = progress >= 0.25;
          const showCave = progress >= 0.75;
          heroCard.style.opacity = showAbout ? "0" : "1";
          aboutCard.style.opacity = showCave ? "0" : "1";
          aboutCard.style.transform = showAbout ? "translateY(0)" : "translateY(110%)";
          caveCard.style.transform = showCave ? "translateY(0)" : "translateY(110%)";
          return;
        }

        const aboutRise = Math.min(progress * 2, 1);
        const caveRise = Math.min(Math.max(progress * 2 - 1, 0), 1);
        const easedAboutRise = 1 - Math.pow(1 - aboutRise, 3);
        const easedCaveRise = 1 - Math.pow(1 - caveRise, 3);
        const heroFade = Math.min(Math.max((aboutRise - 0.78) / 0.18, 0), 1);
        const aboutFade = Math.min(Math.max((caveRise - 0.78) / 0.18, 0), 1);

        heroCard.style.transform = `translateY(${-36 * aboutRise}px) scale(${1 - 0.09 * aboutRise})`;
        heroCard.style.opacity = String(1 - heroFade);
        aboutCard.style.transform = `translateY(${(1 - easedAboutRise) * 108}%) translateY(${-18 * caveRise}px) scale(${1 - 0.07 * caveRise})`;
        aboutCard.style.opacity = String(1 - aboutFade);
        caveCard.style.transform = `translateY(${(1 - easedCaveRise) * 108}%)`;
      };

      let ticking = false;
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateCards();
          ticking = false;
        });
      };

      updateCards();
      requestAnimationFrame(resetInitialPosition);
      addEventListener("load", () => {
        resetInitialPosition();
        setTimeout(resetInitialPosition, 0);
      }, { once: true });
      addEventListener("pageshow", resetInitialPosition);
      addEventListener("scroll", requestUpdate, { passive: true });
      addEventListener("resize", requestUpdate);
      reducedMotion.addEventListener("change", requestUpdate);

      cardLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          if (!stage) return;
          event.preventDefault();
          const progress = Number(link.dataset.cardLink ?? 0);
          const travel = Math.max(stage.offsetHeight - window.innerHeight, 0);
          scrollTo({
            top: stage.offsetTop + travel * progress,
            behavior: reducedMotion.matches ? "auto" : "smooth",
          });
        });
      });

      const githubGrid = document.querySelector<HTMLElement>("[data-github-grid]");
      const githubTotal = document.querySelector<HTMLElement>("[data-github-total]");

      if (githubGrid && githubTotal) {
        fetch("https://github-contributions-api.jogruber.de/v4/ilyastorunn?y=last")
          .then((response) => {
            if (!response.ok) throw new Error("GitHub activity unavailable");
            return response.json();
          })
          .then((payload) => {
            const contributions = Array.isArray(payload.contributions)
              ? payload.contributions.slice(-112)
              : [];
            const cells = [...githubGrid.querySelectorAll<HTMLElement>("i")];
            contributions.forEach((day: { count?: number; date?: string; level?: number }, index: number) => {
              const cell = cells[index];
              if (!cell) return;
              cell.dataset.level = String(Math.min(Number(day.level ?? 0), 4));
              cell.title = `${day.count ?? 0} contributions on ${day.date ?? "this day"}`;
            });
            const total = Object.values(payload.total ?? {}).reduce(
              (sum: number, value) => sum + Number(value ?? 0),
              0,
            );
            githubTotal.textContent = `${total.toLocaleString()} this year`;
          })
          .catch(() => {
            githubTotal.textContent = "Public profile";
          });
      }

      const musicCard = document.querySelector<HTMLElement>("[data-music-card]");
      const musicToggle = document.querySelector<HTMLButtonElement>("[data-music-toggle]");
      const musicAudio = document.querySelector<HTMLAudioElement>("[data-music-audio]");

      if (musicCard && musicToggle && musicAudio) {
        musicAudio.volume = 0.5;
        let autoStartAttempted = false;
        let aboutIsActive = false;

        const setMusicState = (playing: boolean) => {
          musicCard.classList.toggle("is-playing", playing);
          musicToggle.textContent = playing ? "Ⅱ" : "▶";
          musicToggle.setAttribute("aria-pressed", String(playing));
          musicToggle.setAttribute("aria-label", playing ? "Pause All Caps preview" : "Play All Caps preview");
        };

        const tryAutoStart = async () => {
          if (autoStartAttempted || !aboutIsActive) return;
          autoStartAttempted = true;
          try {
            await musicAudio.play();
            setMusicState(true);
          } catch {
            autoStartAttempted = false;
          }
        };

        addEventListener("portfolio-card-change", ((event: CustomEvent<{ activeIndex: number }>) => {
          aboutIsActive = event.detail.activeIndex === 1;
          if (aboutIsActive) void tryAutoStart();
        }) as EventListener);

        const unlockPlayback = (event: Event) => {
          if ((event.target as Element | null)?.closest?.("[data-music-toggle]")) return;
          aboutIsActive = cardLinks[1]?.getAttribute("aria-current") === "page";
          if (aboutIsActive && musicAudio.paused) void tryAutoStart();
        };
        addEventListener("pointerdown", unlockPlayback, { passive: true });
        addEventListener("keydown", unlockPlayback);

        musicToggle.addEventListener("click", async () => {
          if (musicAudio.paused) {
            try {
              await musicAudio.play();
              setMusicState(true);
            } catch {
              setMusicState(false);
            }
          } else {
            musicAudio.pause();
            setMusicState(false);
          }
        });

        musicAudio.addEventListener("ended", () => setMusicState(false));
        musicAudio.addEventListener("pause", () => setMusicState(false));
      }

      const caveBoard = document.querySelector<HTMLElement>("[data-cave-board]");
      const dragItems = [...document.querySelectorAll<HTMLElement>("[data-drag-item]")];

      if (caveBoard) {
        let topLayer = 10;
        const keepItemsInsideBoard = () => {
          dragItems.forEach((item) => {
            if (!item.style.left && !item.style.top) return;
            const maxX = Math.max(caveBoard.clientWidth - item.offsetWidth, 0);
            const maxY = Math.max(caveBoard.clientHeight - item.offsetHeight, 0);
            item.style.left = `${Math.min(Math.max(Number.parseFloat(item.style.left) || 0, 0), maxX)}px`;
            item.style.top = `${Math.min(Math.max(Number.parseFloat(item.style.top) || 0, 0), maxY)}px`;
          });
        };

        dragItems.forEach((item) => {
          item.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) return;
            const boardBounds = caveBoard.getBoundingClientRect();
            const itemBounds = item.getBoundingClientRect();
            const startX = event.clientX;
            const startY = event.clientY;
            const originX = itemBounds.left - boardBounds.left;
            const originY = itemBounds.top - boardBounds.top;
            const maxX = Math.max(boardBounds.width - itemBounds.width, 0);
            const maxY = Math.max(boardBounds.height - itemBounds.height, 0);
            item.setPointerCapture(event.pointerId);
            item.classList.add("is-dragging");
            item.style.zIndex = String(++topLayer);

            const move = (moveEvent: PointerEvent) => {
              const x = Math.min(Math.max(originX + moveEvent.clientX - startX, 0), maxX);
              const y = Math.min(Math.max(originY + moveEvent.clientY - startY, 0), maxY);
              item.style.left = `${x}px`;
              item.style.top = `${y}px`;
              item.style.right = "auto";
              item.style.bottom = "auto";
            };

            const finish = () => {
              item.classList.remove("is-dragging");
              item.removeEventListener("pointermove", move);
              item.removeEventListener("pointerup", finish);
              item.removeEventListener("pointercancel", finish);
            };

            item.addEventListener("pointermove", move);
            item.addEventListener("pointerup", finish);
            item.addEventListener("pointercancel", finish);
          });

          item.addEventListener("keydown", (event) => {
            const movement = { ArrowLeft: [-10, 0], ArrowRight: [10, 0], ArrowUp: [0, -10], ArrowDown: [0, 10] }[event.key];
            if (!movement) return;
            event.preventDefault();
            const boardBounds = caveBoard.getBoundingClientRect();
            const itemBounds = item.getBoundingClientRect();
            const currentX = itemBounds.left - boardBounds.left;
            const currentY = itemBounds.top - boardBounds.top;
            const maxX = Math.max(caveBoard.clientWidth - item.offsetWidth, 0);
            const maxY = Math.max(caveBoard.clientHeight - item.offsetHeight, 0);
            item.style.left = `${Math.min(Math.max(currentX + movement[0], 0), maxX)}px`;
            item.style.top = `${Math.min(Math.max(currentY + movement[1], 0), maxY)}px`;
            item.style.right = "auto";
            item.style.bottom = "auto";
            item.style.zIndex = String(++topLayer);
          });
        });
        addEventListener("resize", keepItemsInsideBoard);
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    min-width: 20rem;
    background: #f1f2f3;
    color: #161817;
    font-family: "Instrument Sans Variable", "Helvetica Neue", Arial, sans-serif;
    font-synthesis: none;
  }

  :global(body) {
    min-height: 100svh;
    margin: 0;
  }

  :global(a) {
    color: inherit;
  }

  .card-stack {
    position: relative;
  }

  .transition-stage {
    position: relative;
    height: 300svh;
  }

  .card-viewport {
    position: sticky;
    top: 0;
    height: 100svh;
    padding: clamp(0.75rem, 2.2vw, 2rem);
    overflow: clip;
  }

