{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ilyas-dev-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
		{ "pattern": "ilyastorun.site", "custom_domain": true },
		{ "pattern": "www.ilyastorun.site", "custom_domain": true }
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
